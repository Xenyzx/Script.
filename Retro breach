--//----------------------------------------------------------
local function AnchorPart(inst)
    if inst:IsA("BasePart") then
        return inst
    end
    if inst:IsA("Tool") then
        local h = inst:FindFirstChild("Handle")
        if h and h:IsA("BasePart") then
            return h
        end
    end
    if inst:IsA("Model") then
        if inst.PrimaryPart then
            return inst.PrimaryPart
        end
        local hrp = inst:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:IsA("BasePart") then
            return hrp
        end
        local p = inst:FindFirstChildOfClass("BasePart")
        if p then
            return p
        end
    end
    if inst:IsA("ProximityPrompt") then
        local par = inst.Parent
        if par and par:IsA("BasePart") then
            return par
        end
    end
    return nil
end

--//----------------------------------------------------------
local function TagWorldThin(cat, inst, text, color)
    if worldVisuals[cat][inst] ~= nil then
        return
    end
    local anchor = AnchorPart(inst)
    if anchor == nil then
        return
    end
    local objs = {}
    pcall(function()
        if Settings.PerformanceMode == false and inst:IsA("Model") then
            local hl = Instance.new("Highlight")
            hl.Adornee = inst
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillColor = color
            hl.OutlineColor = color
            hl.FillTransparency = 0.65
            hl.Parent = inst
            table.insert(objs, hl)
        end
        local bb = Instance.new("BillboardGui")
        bb.Adornee = anchor
        bb.Size = UDim2.fromOffset(180, 32)
        bb.StudsOffset = Vector3.new(0, 2, 0)
        bb.AlwaysOnTop = true
        bb.MaxDistance = 8000
        bb.Parent = anchor
        local lb = Instance.new("TextLabel")
        lb.Size = UDim2.fromScale(1, 1)
        lb.BackgroundTransparency = 1
        lb.TextColor3 = color
        lb.TextStrokeTransparency = 0.55
        lb.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        lb.TextSize = Settings.WorldNameSize
        lb.Font = Enum.Font.Gotham
        lb.TextWrapped = true
        lb.Text = text
        lb.Parent = bb
        table.insert(objs, bb)
    end)
    if #objs > 0 then
        worldVisuals[cat][inst] = objs
    end
end

--//----------------------------------------------------------
local function HasStr(hay, keys)
    local low = string.lower(hay)
    for _, k in ipairs(keys) do
        if string.find(low, string.lower(k), 1, true) then
            return true
        end
    end
    return false
end

--//----------------------------------------------------------
local function IsSCPName(n)
    local low = string.lower(n)
    if string.find(low, "scp", 1, true) then
        return true
    end
    for _, num in ipairs(SCP_NUMS) do
        if string.find(low, num, 1, true) then
            return true
        end
    end
    return false
end

