    b.BackgroundColor3 = BG_CARD
    b.Text = ""
    b.LayoutOrder = order
    b.AutoButtonColor = false
    b.ZIndex = 102
    b.Parent = side
    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, 10)
    bc.Parent = b
    local bs = Instance.new("UIStroke")
    bs.Color = STROKE_CLR
    bs.Thickness = 1
    bs.Parent = b
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 0, 22)
    bar.Position = UDim2.new(0, 6, 0.5, -11)
    bar.BackgroundColor3 = ACCENT
    bar.BorderSizePixel = 0
    bar.ZIndex = 103
    bar.Visible = false
    bar.Parent = b
    local barC = Instance.new("UICorner")
    barC.CornerRadius = UDim.new(1, 0)
    barC.Parent = bar
    local ic = Instance.new("TextLabel")
    ic.Size = UDim2.new(0, 28, 1, 0)
    ic.Position = UDim2.new(0, 13, 0, 0)
    ic.BackgroundTransparency = 1
    ic.Font = Enum.Font.Gotham
    ic.TextSize = 14
    ic.TextColor3 = ACCENT
    ic.Text = icon
    ic.ZIndex = 103
    ic.Parent = b
    local tx = Instance.new("TextLabel")
    tx.Size = UDim2.new(1, -46, 1, 0)
    tx.Position = UDim2.new(0, 42, 0, 0)
    tx.BackgroundTransparency = 1
    tx.Font = Enum.Font.Gotham
    tx.TextSize = 12
    tx.TextXAlignment = Enum.TextXAlignment.Left
    tx.TextColor3 = TEXT_WHITE
    tx.Text = label
    tx.ZIndex = 103
    tx.Parent = b
    tabList[label] = {}
    tabList[label].Btn = b
    tabList[label].Bar = bar
    tabList[label].Stroke = bs
    tabList[label].Page = page
    b.MouseButton1Click:Connect(function()
        for n, t in pairs(tabList) do
            local sel = false
            if n == label then
                sel = true
            end
            t.Bar.Visible = sel
            t.Page.Visible = sel
            if sel == true then
                t.Btn.BackgroundColor3 = BG_HOVER
                t.Stroke.Color = ACCENT
            else
                t.Btn.BackgroundColor3 = BG_CARD
                t.Stroke.Color = STROKE_CLR
            end
        end
    end)
end

