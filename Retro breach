local function AimKeyDown()
    if Settings.AimToggleMode == "Toggle" then
        return toggleLock
    end
    if Settings.AimKeyMode == "LMB" then
        return InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
    end
    if Settings.AimKeyMode == "Q" then
        return InputService:IsKeyDown(Enum.KeyCode.Q)
    end
    return InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
end

