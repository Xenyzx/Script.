local orderAim = 10
local orderVis = 10
local orderWorld = 10
local orderMov = 10
local orderMisc = 10

--//----------------------------------------------------------
local function NextOrder(page)
    local n = page.Name
    if n == "AimPage" then
        orderAim = orderAim + 1
        return orderAim
    end
    if n == "VisPage" then
        orderVis = orderVis + 1
        return orderVis
    end
    if n == "WorldPage" then
        orderWorld = orderWorld + 1
        return orderWorld
    end
    if n == "MovPage" then
        orderMov = orderMov + 1
        return orderMov
    end
    orderMisc = orderMisc + 1
    return orderMisc
end

