local function ClassifySingle(inst)
    if inst == nil then
        return
    end
    if inst.Parent == nil then
        return
    end
    if inst:IsA("Tool") and inst:IsDescendantOf(WorkspaceService) then
        table.insert(MapIndex.tools, inst)
    end
    if inst:IsA("ProximityPrompt") then
        table.insert(MapIndex.prompts, inst)
    end
    if inst:IsA("BasePart") and inst:FindFirstChildOfClass("ClickDetector") then
        table.insert(MapIndex.partsWithClick, inst)
    end
    if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") == nil then
        if #MapIndex.models < 3000 then
            table.insert(MapIndex.models, inst)
        end
    end
end

--//----------------------------------------------------------
local function BuildIndexSlow()
    if MapIndex.building == true then
        return
    end
    MapIndex.building = true
    MapIndex.built = false
    MapIndex.tools = {}
    MapIndex.prompts = {}
    MapIndex.models = {}
    MapIndex.partsWithClick = {}
    task.spawn(function()
        local all = nil
        pcall(function()
            all = WorkspaceService:GetDescendants()
        end)
        if all == nil then
            MapIndex.building = false
            return
        end
        for i, d in ipairs(all) do
            if destroyed == true then
                break
            end
            if i % 250 == 0 then
                task.wait()
                if indexLabelRef then
                    indexLabelRef.Text = "Indexing map... " .. i .. " / " .. #all .. "\nTools:" .. #MapIndex.tools .. " Prompts:" .. #MapIndex.prompts
                end
            end
            pcall(function()
                ClassifySingle(d)
            end)
        end
        MapIndex.count = #all
        MapIndex.built = true
        MapIndex.building = false
        if indexLabelRef then
            indexLabelRef.Text = "Indexed: " .. #all .. " objects\nTools:" .. #MapIndex.tools .. " Prompts:" .. #MapIndex.prompts .. "\nNow press SCAN FROM INDEX."
        end
        Notify("Index done", "Map cached, no lag")
    end)
end

--//----------------------------------------------------------
local function ScanFromIndex()
    local mp = MyPos()
    local addedE = 0
    local addedC = 0
    local addedG = 0
    local addedN = 0
    local addedP = 0
    if Settings.EntityESP == true then
        for _, m in ipairs(MapIndex.models) do
            if CountCat("Entity") >= 20 then
                break
            end
            if m.Parent and m:FindFirstChildOfClass("Humanoid") then
                local hum = m:FindFirstChildOfClass("Humanoid")
                if hum.Health > 0 and PlayersService:GetPlayerFromCharacter(m) == nil and worldVisuals.Entity[m] == nil and IsDowned(m) == false then
                    if Settings.SCPOnly == false or IsSCPName(m.Name) then
                        local a = AnchorPart(m)
                        if a and (a.Position - mp).Magnitude <= Settings.EntityMaxDist then
                            TagWorldThin("Entity", m, m.Name .. "\n" .. math.floor((a.Position - mp).Magnitude) .. "st", COL_ENTITY)
                            addedE = addedE + 1
                        end
                    end
                end
            end
        end
    end
    for _, t in ipairs(MapIndex.tools) do
        if CountCat("Keycard") + CountCat("Gun") + CountCat("Grenade") >= 30 then
            break
        end
        if t.Parent and t:IsDescendantOf(WorkspaceService) and worldVisuals.Keycard[t] == nil and worldVisuals.Gun[t] == nil and worldVisuals.Grenade[t] == nil then
            local a = AnchorPart(t)
            if a and (a.Position - mp).Magnitude <= Settings.PickupMaxDist then
                local dist = math.floor((a.Position - mp).Magnitude)
                if Settings.KeycardESP and HasStr(t.Name, KEY_KEYCARD) and CountCat("Keycard") < 12 then
                    TagWorldThin("Keycard", t, "[CARD] " .. t.Name .. "\n" .. dist .. "st", COL_KEYCARD)
                    addedC = addedC + 1
                elseif Settings.GunESP and HasStr(t.Name, KEY_GUN) and CountCat("Gun") < 12 then
                    TagWorldThin("Gun", t, "[GUN] " .. t.Name .. "\n" .. dist .. "st", COL_GUN)
                    addedG = addedG + 1
                elseif Settings.GrenadeESP and HasStr(t.Name, KEY_NADE) and CountCat("Grenade") < 8 then
                    TagWorldThin("Grenade", t, "[NADE] " .. t.Name .. "\n" .. dist .. "st", COL_NADE)
                    addedN = addedN + 1
                end
            end
        end
    end
    for _, p in ipairs(MapIndex.partsWithClick) do
        if p.Parent and Settings.KeycardESP and CountCat("Keycard") < 12 and worldVisuals.Keycard[p] == nil then
            local a = AnchorPart(p)
            if a and (a.Position - mp).Magnitude <= Settings.PickupMaxDist and HasStr(p.Name, {"card", "key", "level"}) then
                TagWorldThin("Keycard", p, "[CARD] " .. p.Name, COL_KEYCARD)
                addedC = addedC + 1
            end
        end
    end
    if Settings.InteractESP == true then
        for _, pr in ipairs(MapIndex.prompts) do
            if CountCat("Prompt") >= 15 then
                break
            end
            if pr.Parent and worldVisuals.Prompt[pr] == nil then
                TagWorldThin("Prompt", pr, pr.ActionText .. " " .. pr.ObjectText, COL_PROMPT)
                addedP = addedP + 1
            end
        end
    end
    Notify("Scan", "E:" .. addedE .. " C:" .. addedC .. " G:" .. addedG .. " N:" .. addedN .. " P:" .. addedP)
end

