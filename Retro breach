local function BuildLabelText(player, dist, hp)
    local t = player.DisplayName
    if Settings.ShowTeam == true then
        local tn = "No Team"
        if player.Team ~= nil then
            tn = player.Team.Name
        end
        t = t .. "\n[" .. tn .. "]"
    end
    local parts = {}
    if Settings.ShowDistance == true and dist ~= nil then
        table.insert(parts, tostring(math.floor(dist)) .. "st")
    end
    if Settings.ShowHealth == true and hp ~= nil then
        table.insert(parts, tostring(math.floor(hp)) .. "hp")
    end
    if #parts > 0 then
        t = t .. "\n" .. table.concat(parts, " | ")
    end
    return t
end

