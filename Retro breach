        end)
    end)
end

--//----------------------------------------------------------
--// JUMP FIX CORE
--//----------------------------------------------------------
local function ForceJumpEnable()
    local hum, hrp = GetHumanoid()
    if hum == nil then
        return
    end
    if hum.JumpPower >= 10 then
        return
    end
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
    end)
    pcall(function()
        hum.UseJumpPower = true
    end)
    pcall(function()
        hum.JumpPower = Settings.JumpPower
    end)
end

--//----------------------------------------------------------
local function FullJumpReset()
    local hum, hrp = GetHumanoid()
    if hum == nil then
        return
    end
    pcall(function()
        hum.UseJumpPower = true
    end)
    pcall(function()
        hum.JumpPower = Settings.JumpPower
    end)
    pcall(function()
        hum.JumpHeight = Settings.JumpHeight
    end)
    pcall(function()
        hum.WalkSpeed = 16
    end)
    if hrp ~= nil then
        pcall(function()
            hrp.Velocity = Vector3.new(0, 0, 0)
        end)
    end
end

--//----------------------------------------------------------
local function LightStamina()
    if Settings.StaminaEnabled == false then
        return
    end
    local char = LocalPlayer.Character
    if char == nil then
        return
    end
    pcall(function()
        local v = char:FindFirstChild("Stamina")
        if v and v:IsA("NumberValue") and v.Value < 99 then
            v.Value = 100
        end
    end)
end

--//----------------------------------------------------------
local function SetNoclip(on)
    if noclipLoop ~= nil then
        pcall(function()
            noclipLoop:Disconnect()
        end)
        noclipLoop = nil
    end
    if on == true then
        noclipLoop = RunService.Stepped:Connect(function()
            if destroyed == true then
                return
            end
            if Settings.NoclipEnabled == false then
                return
            end
            local char = LocalPlayer.Character
            if char == nil then
                return
            end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)
        table.insert(connections, noclipLoop)
    else
        FullJumpReset()
    end
end

