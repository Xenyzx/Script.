--//----------------------------------------------------------
--// HELPERS
--//----------------------------------------------------------
local function IsAlly(player)
    if player == LocalPlayer then
        return true
    end
    if Settings.TeamCheck == false then
        return false
    end
    if player.Team == nil then
        return false
    end
    if LocalPlayer.Team == nil then
        return false
    end
    local myTeam = LocalPlayer.Team.Name
    local hisTeam = player.Team.Name
    local list = ALLIES[myTeam]
    if list == nil then
        if myTeam == hisTeam then
            return true
        else
            return false
        end
    end
    if list[hisTeam] == true then
        return true
    end
    return false
end

--//----------------------------------------------------------
local function GetTeamColor(player)
    if player.Team ~= nil then
        return player.Team.TeamColor.Color
    end
    return Color3.fromRGB(255, 255, 255)
end

--//----------------------------------------------------------
local function SafeTween(obj, t, props)
    pcall(function()
        local info = TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tw = TweenService:Create(obj, info, props)
        tw:Play()
    end)
end

--//----------------------------------------------------------
local function GetHumanoid()
    local char = LocalPlayer.Character
    if char == nil then
        return nil, nil
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    return hum, hrp
end

--//----------------------------------------------------------
local function MyPos()
    local _, hrp = GetHumanoid()
    if hrp ~= nil then
        return hrp.Position
    end
    local cam = WorkspaceService.CurrentCamera
    if cam ~= nil then
        return cam.CFrame.Position
    end
    return Vector3.new(0, 0, 0)
end

--//----------------------------------------------------------
local function IsDowned(char)
    if Settings.DownedCheck == false then
        return false
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum == nil then
        return true
    end
    if hum.Health <= 0 then
        return true
    end
    if char:GetAttribute("Downed") == true then
        return true
    end
    if char:GetAttribute("KO") == true then
        return true
    end
    return false
end

--//----------------------------------------------------------
local function GetThinStroke()
    local v = Settings.NameOutline
    if v == nil then
        v = 60
    end
    return v / 100
end

