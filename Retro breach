--//----------------------------------------------------------
local function HasWall(camPos, targetPos, ignoreList)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignoreList
    params.IgnoreWater = true
    local r = WorkspaceService:Raycast(camPos, targetPos - camPos, params)
    return r ~= nil
end

--//----------------------------------------------------------
local function GetBoneToUse(char, camPos, ignoreList)
    local order = {}
    order[1] = Settings.TARGET_PART
    if Settings.BoneFallback == true then
        for _, b in ipairs({"Head", "UpperTorso", "HumanoidRootPart"}) do
            if b ~= Settings.TARGET_PART then
                table.insert(order, b)
            end
        end
    end
    for _, bn in ipairs(order) do
        local part = char:FindFirstChild(bn)
        if part and part:IsA("BasePart") then
            if Settings.WallCheck == true then
                if HasWall(camPos, part.Position, ignoreList) == false then
                    return part
                end
            else
                return part
            end
        end
    end
    return nil
end

--//----------------------------------------------------------
local function ScoreTarget(pl, char, part, screenD, worldD)
    if Settings.Prioritize == "LowestHP" then
        local h = char:FindFirstChildOfClass("Humanoid")
        local hp = 100
        if h then
            hp = h.Health
        end
        return screenD + hp * 0.5
    end
    if Settings.Prioritize == "Closest" then
        return screenD * 0.4 + worldD * 0.8
    end
    return screenD
end

--//----------------------------------------------------------
local function GetClosestTarget()
    local cam = WorkspaceService.CurrentCamera
    if cam == nil then
        return nil, nil
    end
    local vs = cam.ViewportSize
    local center = Vector2.new(vs.X / 2, vs.Y / 2)
    local camPos = cam.CFrame.Position
    local best = nil
    local bestPl = nil
    local bestScore = Settings.AIM_FOV
    local myChar = LocalPlayer.Character
    for _, plr in ipairs(PlayersService:GetPlayers()) do
        if plr ~= LocalPlayer and IsAlly(plr) == false then
            local char = plr.Character
            if char ~= nil and IsDowned(char) == false then
                local ig = {}
                if myChar ~= nil then
                    table.insert(ig, myChar)
                end
                table.insert(ig, char)
                local part = GetBoneToUse(char, camPos, ig)
                if part then
                    local dist = (part.Position - camPos).Magnitude
                    if dist <= Settings.MAX_DISTANCE then
                        local sp, on = cam:WorldToViewportPoint(part.Position)
                        if on == true and sp.Z > 0 then
                            local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if sd <= Settings.AIM_FOV then
                                local sc = ScoreTarget(plr, char, part, sd, dist)
                                if sc <= bestScore then
                                    bestScore = sc
                                    best = part
                                    bestPl = plr
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best, bestPl
end

