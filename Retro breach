    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    for char, e in pairs(visuals) do
        if e.list ~= nil then
            for _, o in ipairs(e.list) do
                if o ~= nil and o.Parent ~= nil then
                    o:Destroy()
                end
            end
        end
        visuals[char] = nil
    end
    ClearAllWorld()
    for hrp, sz in pairs(hitboxApplied) do
        pcall(function()
            hrp.Size = sz
        end)
    end
    if gui ~= nil and gui.Parent ~= nil then
