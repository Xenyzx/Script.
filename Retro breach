RunService:BindToRenderStep(AIM_BIND_NAME, Enum.RenderPriority.Last.Value, function()
    if destroyed == true then
        return
    end
    local cam = WorkspaceService.CurrentCamera
    if cam == nil then
        return
    end
    if Settings.FOVRainbow == true and lowFPSMode == false then
        local h = (os.clock() % 5) / 5
        local c = Color3.fromHSV(h, 0.9, 1)
        fovStroke.Color = c
        fovFill.BackgroundColor3 = c
    end
    if Settings.JumpFix == true then
        local hum = GetHumanoid()
        if hum ~= nil then
            if hum.JumpPower < 10 then
                hum.JumpPower = Settings.JumpPower
            end
            pcall(function()
                hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            end)
        end
    end
    if Settings.SpeedEnabled == true then
        local hum = GetHumanoid()
        if hum ~= nil then
            local want = 16 * Settings.SpeedMultiplier
            if hum.WalkSpeed ~= want then
                hum.WalkSpeed = want
            end
        end
    end
    if Settings.FlyEnabled == true then
        local hum, hrp = GetHumanoid()
        if hum ~= nil and hrp ~= nil then
            local speed = Settings.FlySpeed
            if flyKeys.Shift == true then
                speed = speed * 2
            end
            local dir = Vector3.new(0, 0, 0)
            local cf = cam.CFrame
            if flyKeys.W then dir = dir + cf.LookVector end
            if flyKeys.S then dir = dir - cf.LookVector end
            if flyKeys.D then dir = dir + cf.RightVector end
            if flyKeys.A then dir = dir - cf.RightVector end
            if flyKeys.E or flyKeys.Space then dir = dir + Vector3.new(0, 1, 0) end
            if flyKeys.Q then dir = dir - Vector3.new(0, 1, 0) end
            if dir.Magnitude > 0 then
                dir = dir.Unit * speed
            end
            hrp.Velocity = dir
        end
    end
    if Settings.AimEnabled == false then
        marker.Visible = false
        tracer.Visible = false
        return
    end
    local down = false
    pcall(function() down = AimKeyDown() end)
    if down == false then
        marker.Visible = false
        tracer.Visible = false
        return
    end
    local target, pl = GetClosestTarget()
    if target == nil then
        marker.Visible = false
        tracer.Visible = false
        return
    end
    if pl then
        currentTargetName = pl.DisplayName
    else
        currentTargetName = target.Parent.Name
    end
    local goal = CFrame.lookAt(cam.CFrame.Position, target.Position)
    if Settings.Smoothness <= 1 then
        cam.CFrame = goal
    else
        cam.CFrame = cam.CFrame:Lerp(goal, 1 / Settings.Smoothness)
    end
    pcall(function()
        local sp, on = cam:WorldToViewportPoint(target.Position)
        if on then
            local cx = cam.ViewportSize.X / 2
            local cy = cam.ViewportSize.Y / 2
            if Settings.ShowMarker then
                marker.Visible = true
                marker.Position = UDim2.fromOffset(sp.X, sp.Y)
            else
                marker.Visible = false
            end
            if Settings.ShowTracer then
                tracer.Visible = true
                local dx = sp.X - cx
                local dy = sp.Y - cy
                local len = math.sqrt(dx * dx + dy * dy)
                tracer.Size = UDim2.new(0, math.max(len, 1), 0, 1.5)
                tracer.Position = UDim2.fromOffset(cx, cy)
                tracer.Rotation = math.deg(math.atan2(dy, dx))
            else
                tracer.Visible = false
            end
        else
            marker.Visible = false
            tracer.Visible = false
        end
    end)
end)

