    -- SCP LOCATION ESP
    local locationDraws = {}
    local locationCache = {}
    local locationRefreshT = 0

    local function getLocationPosition(obj)
        if obj:IsA("BasePart") then return obj.Position end
        if obj:IsA("Model") then return obj:GetPivot().Position end
        if obj:IsA("Attachment") then return obj.WorldPosition end
        return nil
    end

    local function matchesSCPName(name, id)
        local n = string.lower(name):gsub("[%s_%-]", "")
        return n == id or n == "scp" .. id
    end

    local function findSCPLocations()
        local found = {}
        if not (Settings.Location914Enabled or Settings.Location035Enabled) then return found end
        for _, obj in ipairs(Workspace:GetDescendants()) do
            local pos = getLocationPosition(obj)
            if pos then
                if Settings.Location914Enabled and matchesSCPName(obj.Name, "914") then
                    found["SCP-914"] = {object = obj, position = pos}
                end
                if Settings.Location035Enabled and matchesSCPName(obj.Name, "035") then
                    found["SCP-035"] = {object = obj, position = pos}
                end
            end
        end
        return found
    end

    local function clearLocationDraws()
        for key, d in pairs(locationDraws) do
            pcall(function() d.text:Remove() end)
            pcall(function() d.dot:Remove() end)
            locationDraws[key] = nil
        end
        table.clear(locationCache)
    end

    local locationConn = RunService.RenderStepped:Connect(function(dt)
        locationRefreshT = locationRefreshT + dt
        if locationRefreshT >= 0.5 then
            locationRefreshT = 0
            locationCache = findSCPLocations()
            for key, d in pairs(locationDraws) do
                if not locationCache[key] then
                    pcall(function() d.text:Remove() end)
                    pcall(function() d.dot:Remove() end)
                    locationDraws[key] = nil
                end
            end
            for key in pairs(locationCache) do
                if not locationDraws[key] then
                    local t = Drawing.new("Text")
                    t.Center, t.Outline, t.Size, t.Font, t.Visible = true, true, 14, 2, false
                    t.OutlineColor = Color3.new(0,0,0)
                    local dot = Drawing.new("Square")
                    dot.Filled, dot.Size, dot.Visible = true, Vector2.new(7,7), false
                    locationDraws[key] = {text=t, dot=dot}
                end
            end
        end
        for key, d in pairs(locationDraws) do
            local info = locationCache[key]
            local visible = false
            if info then
                local dist = (Camera.CFrame.Position - info.position).Magnitude
                if dist <= Settings.LocationMaxDist then
                    local sp, on = Camera:WorldToViewportPoint(info.position)
                    if on and sp.Z > 0 then
                        visible = true
                        local col = key == "SCP-914" and Color3.fromRGB(255,190,70) or Color3.fromRGB(225,90,255)
                        d.dot.Visible, d.dot.Color = true, col
                        d.dot.Position = Vector2.new(sp.X-3.5, sp.Y-3.5)
                        d.text.Visible, d.text.Color = true, col
                        d.text.Text = string.format("%s Location [%dm]", key, math.floor(dist))
                        d.text.Position = Vector2.new(sp.X, sp.Y-18)
                    end
                end
            end
            if not visible then d.text.Visible, d.dot.Visible = false, false end
        end
    end)

