            Position = UDim2.new(1, -60, 0.5, -12),

            BackgroundColor3 = PANEL2,

            Text = "",

            AutoButtonColor = false

        }, row)

        corner(b, 12)

        local knob = new("Frame", {

            Size = UDim2.fromOffset(18, 18),

            Position = UDim2.fromOffset(3, 3),

            BackgroundColor3 = Color3.fromRGB(160, 163, 170),

            BorderSizePixel = 0

        }, b)

        corner(knob, 10)

        local function refresh()

            local on = Settings.ItemCats[cat] == true

            b.BackgroundColor3 = on and ACCENT or PANEL2

            knob.Position = on and UDim2.new(1, -21, 0, 3) or UDim2.fromOffset(3, 3)

            knob.BackgroundColor3 = on and Color3.fromRGB(255,255,255) or Color3.fromRGB(160,163,170)

        end

        b.MouseButton1Click:Connect(function()

            Settings.ItemCats[cat] = not Settings.ItemCats[cat]

            refresh()

        end)

        refresh()

    end

