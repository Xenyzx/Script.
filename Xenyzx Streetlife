local frame = 0
local curAim = nil
local conn = RunService.Heartbeat:Connect(function()
    frame = frame + 1
    Camera = workspace.CurrentCamera
    if not Camera then return end
    if frame % 2 == 0 then
        silPart, silPlr, silScreen = findSilent()
    end
    pcall(updateVehicle)
    pcall(function()
        local mp = UIS:GetMouseLocation()
        if SilCircle then
            local showS = State.SilentShow and State.SilentOn and menuOpen
            SilCircle.Visible = showS
            SilTracer.Visible = false
            if showS then
                SilCircle.Size = UDim2.new(0, State.SilentFOV * 2, 0, State.SilentFOV * 2)
                SilCircle.Position = UDim2.new(0, mp.X, 0, mp.Y)
                if silPart then SilStroke.Color = VIS else SilStroke.Color = PINK end
                if silScreen and silPart then
                    local fromX = Camera.ViewportSize.X / 2
                    local fromY = Camera.ViewportSize.Y
                    local dx = silScreen.X - fromX
                    local dy = silScreen.Y - fromY
                    local len = math.sqrt(dx * dx + dy * dy)
                    if len > 4 then
                        SilTracer.Visible = true
                        SilTracer.Size = UDim2.new(0, len, 0, 2)
                        SilTracer.Position = UDim2.new(0, (fromX + silScreen.X) / 2, 0, (fromY + silScreen.Y) / 2)
                        SilTracer.Rotation = math.deg(math.atan2(dy, dx))
                        if curAim and silPlr and curAim == silPlr then
                            SilTracer.BackgroundColor3 = CYAN
                        else
                            SilTracer.BackgroundColor3 = PINK
                        end
                    end
                end
            end
        end
        if AimCircle then
            local showA = State.AimShow and State.AimOn and menuOpen
            AimCircle.Visible = showA
            if showA then
                AimCircle.Size = UDim2.new(0, State.AimFOV * 2, 0, State.AimFOV * 2)
                AimCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
            end
        end
    end)
    pcall(function()
        local tgt, pos = findAim()
        curAim = tgt
        if tgt and pos then
            local ch = tgt.Character
            local r = nil
            if ch then r = ch:FindFirstChild("HumanoidRootPart") end
                if r then pos = pos + r.Velocity * State.AimPred end
            local t = math.clamp(1 / math.max(1, State.AimSmooth), 0.05, 1)
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pos), t)
        end
    end)
    if frame % 3 ~= 0 then return end
    pcall(function()
        local mr = myRoot()
        for _, plr in pairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end
            local s = getS(plr)
            local c, hum, root = validChar(plr)
            if not c then
                s.hl.Enabled = false
                s.bill.Enabled = false
                s.box.Visible = false
                continue
            end
            local dist = 0
            if mr then dist = (mr.Position - root.Position).Magnitude end
            if dist > State.MaxDist then
                s.hl.Enabled = false
                s.bill.Enabled = false
                s.box.Visible = false
                continue
            end
            local head = c:FindFirstChild("Head")
            local apos = root.Position
            if head then apos = head.Position end
            local col = VIS
            if not vis(Camera.CFrame.Position, apos, c) then col = HID end
            if State.Chams then
                if s.hl.Adornee ~= c then s.hl.Adornee = c end
                s.hl.Enabled = true
                s.hl.FillColor = col
                s.hl.OutlineColor = col
                s.hl.FillTransparency = State.Fill
            else
                s.hl.Enabled = false
            end
            if State.Name or State.Dist then
                local ad = head or root
                if s.bill.Adornee ~= ad then s.bill.Adornee = ad end
                s.bill.Enabled = true
                s.n.Visible = State.Name
                s.d.Visible = State.Dist
                if State.Name then
                    s.n.Text = plr.Name
                    s.n.TextColor3 = col
                end
                if State.Dist then s.d.Text = math.floor(dist) .. " studs" end
            else
                s.bill.Enabled = false
            end
            if State.Box then
                local topPos = root.Position + Vector3.new(0, 3, 0)
                if head then topPos = head.Position + Vector3.new(0, 1, 0) end
                local botPos = root.Position - Vector3.new(0, 3, 0)
                local t2, tOn = Camera:WorldToViewportPoint(topPos)
                local b2, bOn = Camera:WorldToViewportPoint(botPos)
                if tOn and bOn then
                    local h = math.abs(b2.Y - t2.Y)
                    local w = h * 0.6
                    s.box.Visible = true
                    s.box.Size = UDim2.new(0, w, 0, h)
                    s.box.Position = UDim2.new(0, (t2.X + b2.X) / 2 - w / 2, 0, (t2.Y + b2.Y) / 2 - h / 2)
                    s.boxStroke.Color = col
                else
                    s.box.Visible = false
                end
            else
                s.box.Visible = false
            end
            if silPlr == plr then
                s.hl.FillColor = PINK
                s.hl.OutlineColor = PINK
            elseif curAim == plr then
                s.hl.FillColor = CYAN
                s.hl.OutlineColor = CYAN
            end
        end
        if miscLabel then
            local sn = "none"
            if silPlr then sn = silPlr.Name end
            local an = "none"
            if curAim then an = curAim.Name end
            local vn = "foot"
