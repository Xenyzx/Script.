local vehSeatBoosted = nil
local vehOrigMax = 0
local vehTuneObj = nil
local vehOrigHP = 0
local vehAppliedMult = 0
local flyGyro = nil
local flyVel = nil
local function getSeat()
    local ch = LocalPlayer.Character
    local hum = nil
    if ch then hum = ch:FindFirstChildWhichIsA("Humanoid") end
    local seat = nil
    if hum then seat = hum.SeatPart end
    if seat and seat:IsA("VehicleSeat") then return seat end
    return nil
end
local function clearFly()
    pcall(function() if flyGyro then flyGyro:Destroy() end end)
    pcall(function() if flyVel then flyVel:Destroy() end end)
    flyGyro = nil
    flyVel = nil
end
local function restoreBoost()
    pcall(function()
        if vehSeatBoosted and vehSeatBoosted.Parent then
            vehSeatBoosted.MaxSpeed = vehOrigMax
        end
        if vehTuneObj and vehTuneObj.Parent then
            vehTuneObj.Value = vehOrigHP
        end
    end)
    vehSeatBoosted = nil
    vehTuneObj = nil
    vehAppliedMult = 0
end
local function updateVehicle()
    local seat = getSeat()
    if State.VehSpeedOn and seat then
        if vehSeatBoosted ~= seat or vehAppliedMult ~= State.VehSpeedMult then
            restoreBoost()
            vehOrigMax = seat.MaxSpeed
            seat.MaxSpeed = vehOrigMax * State.VehSpeedMult
            vehSeatBoosted = seat
            vehAppliedMult = State.VehSpeedMult
            local model = seat:FindFirstAncestorOfClass("Model")
            if model then
                for _, d in ipairs(model:GetDescendants()) do
                    if d.Name == "HorsePower" and (d:IsA("NumberValue") or d:IsA("IntValue")) then
                        vehTuneObj = d
                        vehOrigHP = d.Value
                        d.Value = vehOrigHP * State.VehSpeedMult
                        break
                    end
                end
            end
        end
    else
        if vehSeatBoosted then restoreBoost() end
    end
    local root = nil
    if seat then
        pcall(function() root = seat.AssemblyRootPart end)
        if not root then root = seat end
    end
    if State.VehBrakeOn and seat and root then
        local braking = UIS:IsKeyDown(Enum.KeyCode.S)
        if not braking then
            pcall(function()
                if seat.ThrottleFloat < -0.1 then braking = true end
            end)
        end
        if braking then
            pcall(function()
                local v = root.AssemblyLinearVelocity
                local f = math.clamp(1 - 0.08 * State.VehBrakeMult, 0, 1)
                root.AssemblyLinearVelocity = Vector3.new(v.X * f, v.Y, v.Z * f)
            end)
        end
    end
    if State.VehFlyOn and seat and root and Camera then
        if not flyGyro or not flyVel or flyGyro.Parent == nil or flyVel.Parent == nil then
            clearFly()
            flyGyro = Instance.new("BodyGyro")
            flyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
            flyGyro.P = 3000
            flyGyro.Parent = root
            flyVel = Instance.new("BodyVelocity")
            flyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            flyVel.Parent = root
        end
        local look = Camera.CFrame.LookVector
        local right = Camera.CFrame.RightVector
        local dir = Vector3.new(0, 0, 0)
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + look end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - look end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + right end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - right end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
        pcall(function()
            flyGyro.CFrame = CFrame.new(root.Position, root.Position + look)
            if dir.Magnitude > 0.1 then
                flyVel.Velocity = dir.Unit * State.VehFlySpeed
            else
                flyVel.Velocity = Vector3.new(0, 0, 0)
            end
        end)
    else
        clearFly()
    end
end

