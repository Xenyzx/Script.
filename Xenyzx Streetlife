local function myRoot()
    local c = LocalPlayer.Character
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso")
end
local function validChar(plr)
    if plr == LocalPlayer then return nil end
    if isAlly(plr) then return nil end
    local c = plr.Character
    if not c then return nil end
    local hum = c:FindFirstChildWhichIsA("Humanoid")
    if not hum then return nil end
    if hum.Health <= 0 then return nil end
    local root = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso")
    if not root then return nil end
    return c, hum, root
end

local rayP = RaycastParams.new()
pcall(function() rayP.FilterType = Enum.RaycastFilterType.Exclude end)
pcall(function() rayP.IgnoreWater = true end)
local function vis(fromPos, toPos, ch)
    local ok, r = pcall(function()
        rayP.FilterDescendantsInstances = {LocalPlayer.Character, ch, workspace.CurrentCamera}
        return workspace:Raycast(fromPos, toPos - fromPos, rayP) == nil
    end)
    if ok then return r end
    return true
end
local function roll(p)
    if p >= 100 then return true end
    if p <= 0 then return false end
    return math.random(1, 100) <= p
end

local silPart = nil
local silPlr = nil
local silScreen = nil
local function pickSilent(char)
    if State.HitPart == "Head" then return char:FindFirstChild("Head") end
    if State.HitPart == "Torso" then return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end
local function findSilent()
    if not State.SilentOn then return nil, nil, nil end
    if not Camera then return nil, nil, nil end
    local mp = UIS:GetMouseLocation()
    local bp, bl, bs, bd = nil, nil, nil, State.SilentFOV
    local mr = myRoot()
    for _, plr in pairs(Players:GetPlayers()) do
        local c, hum, root = validChar(plr)
        if c then
            local dist = 0
            if mr then dist = (mr.Position - root.Position).Magnitude end
            if dist <= State.MaxDist then
                local part = pickSilent(c)
                if part then
                    local sp, on = Camera:WorldToViewportPoint(part.Position)
                    if on then
                        local sd = (Vector2.new(sp.X, sp.Y) - mp).Magnitude
                        if sd <= State.SilentFOV and sd < bd then
                            if not State.SilentWallCheck or vis(Camera.CFrame.Position, part.Position, c) then
                                bp = part
                                bl = plr
                                bs = Vector2.new(sp.X, sp.Y)
                                bd = sd
                            end
                        end
                    end
                end
            end
        end
    end
    return bp, bl, bs
end

local aimLock = nil
local function aimPosOf(char)
    if State.AimPart == "Head" then
        local h = char:FindFirstChild("Head")
        if h then return h.Position end
    end
    local r = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if r then return r.Position end
    return nil
end
local function findAim()
    if not State.AimOn then return nil, nil end
    local want = false
    if State.AimMode == "Always" then want = true end
    if State.AimMode == "Hold RMB" and holdingRMB then want = true end
    if not want then
        if State.AimMode ~= "Always" then aimLock = nil end
        return nil, nil
    end
    if not Camera then return nil, nil end
    if State.AimSticky and aimLock then
        local c = aimLock.Character
        local hum = c and c:FindFirstChildWhichIsA("Humanoid")
        if aimLock.Parent and c and hum and hum.Health > 0 and not isAlly(aimLock) then
            local ap = aimPosOf(c)
            if ap then
                local sp, on = Camera:WorldToViewportPoint(ap)
                if on then
                    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    if (Vector2.new(sp.X, sp.Y) - center).Magnitude <= State.AimFOV * 1.5 then
                        return aimLock, ap
                    end
                end
            end
        end
        aimLock = nil
    end
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local best, bpos, bd = nil, nil, State.AimFOV
    local mr = myRoot()
    for _, plr in pairs(Players:GetPlayers()) do
        local c, hum, root = validChar(plr)
        if c then
            local d = 0
            if mr then d = (mr.Position - root.Position).Magnitude end
            if d <= State.MaxDist then
                local ap = aimPosOf(c)
                if ap then
                    local sp, on = Camera:WorldToViewportPoint(ap)
                    if on then
                        local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if sd <= State.AimFOV and sd < bd then
                            if not State.AimWall or vis(Camera.CFrame.Position, ap, c) then
                                best = plr
                                bpos = ap
                                bd = sd
                            end
                        end
                    end
                end
            end
        end
    end
    if best and State.AimSticky then aimLock = best end
    return best, bpos
end

local okP, Projectile = pcall(require, game:GetService("ReplicatedStorage").Modules.GunFramework.Modules.Projectile)
if okP and Projectile and Projectile.new then
    local origNew = Projectile.new
    Projectile.new = function(params)
        if State.SilentOn and params and params.Origin and params.Direction then
            local head = silPart
            if head and head:IsDescendantOf(workspace) then
                if roll(State.HitChance) then
                    -- Bullet TP mode (from your bullet TP script): spawn above head, shoot down
                    if State.BulletTP then
                        params.Origin = head.Position + Vector3.new(0, 2, 0)
                        params.Direction = Vector3.new(0, -1, 0)
                    else
                        local tp = head.Position
                        if State.SilentPred > 0 then
                            local m = head:FindFirstAncestorOfClass("Model")
                            local hr = nil
                            if m then hr = m:FindFirstChild("HumanoidRootPart") end
                            if hr then tp = tp + hr.Velocity * State.SilentPred end
                        end
                        params.Direction = (tp - params.Origin).Unit
                        -- Wallbang mode (from your wallbang script): Include-only filter hits through walls
                        if State.Wallbang and params.RaycastParams then
                            pcall(function()
                                params.RaycastParams.FilterDescendantsInstances = {head.Parent}
                                params.RaycastParams.FilterType = Enum.RaycastFilterType.Include
                            end)
                        end
                    end
                end
            end
        end
        return origNew(params)
    end
    print("[SX] silent hooked (wallbang + bulletTP merged)")
else
    warn("[SX] Projectile module missing")
end

