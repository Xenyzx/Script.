-- kill old run (prevents doubles when you re-execute)
pcall(function()
    if getgenv and getgenv()._ESP_V2_CONN then getgenv()._ESP_V2_CONN:Disconnect() end
    if getgenv and getgenv()._ESP_V2_DRAW then
        for _, v in pairs(getgenv()._ESP_V2_DRAW) do pcall(function() v:Remove() end) end
    end
end)
