local function enemy(p)
    if p == LocalPlayer then return false end
    if State.TeamCheck and LocalPlayer.Team and p.Team and LocalPlayer.Team == p.Team then return false end
    return true
end
local RP = RaycastParams.new() RP.FilterType = Enum.RaycastFilterType.Exclude RP.IgnoreWater = true
local VisCache = {}
local function visCached(plr, char, myChar)
    local now = os.clock()
    local e = VisCache[plr.UserId]
    if e and (now - e.t) < 0.15 then return e.v end
    local v = false
    local t = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    local mh = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if Cam and t and mh then
        local o = Cam.CFrame.Position local d = t.Position - o
        if d.Magnitude < 3 then v = true
        else
            RP.FilterDescendantsInstances = {myChar, char}
            local ok, r = pcall(function() return workspace:Raycast(o, d, RP) end)
            v = (not ok) or (r == nil)
        end
    end
    VisCache[plr.UserId] = {v = v, t = now}
    return v
end
local function w2s(p)
    local c = workspace.CurrentCamera
    if not c then return Vector2.new(0,0), false end
    Cam = c
    local v, on = c:WorldToViewportPoint(p)
    return Vector2.new(v.X, v.Y), on
end
local function aimPos(char)
    if State.AimPart == "Head" then
        local h = char:FindFirstChild("Head") return h and h.Position
    else
        local u = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
        return u and u.Position
    end
end
local function sset(o, prop, val) pcall(function() o[prop] = val end) end
local hasD = typeof(Drawing) == "table" or typeof(Drawing) == "userdata"
local function getline(i)
    local l = lines[i]
    if l then local ok = pcall(function() return l.Visible end) if ok then return l end end
    local ok, nl = pcall(function() return Drawing.new("Line") end)
    if not ok or not nl then return nil end
    sset(nl,"Visible",false) sset(nl,"Thickness",1.5) sset(nl,"Transparency",1) sset(nl,"Opacity",1) sset(nl,"Color",VIS)
    lines[i] = nl if getgenv then table.insert(getgenv()._RF_DRAW, nl) end
    return nl
end
local function getcirc(i)
    local c = circles[i]
    if c then local ok = pcall(function() return c.Visible end) if ok then return c end end
    local ok, nc = pcall(function() return Drawing.new("Circle") end)
    if not ok or not nc then return nil end
    sset(nc,"Visible",false) sset(nc,"Thickness",1.5) sset(nc,"Transparency",1) sset(nc,"Opacity",1)
    sset(nc,"NumSides",24) sset(nc,"Sides",24) sset(nc,"Filled",false) sset(nc,"Color",VIS)
    circles[i] = nc if getgenv then table.insert(getgenv()._RF_DRAW, nc) end
    return nc
end
local fovCirc
if hasD then pcall(function()
    fovCirc = Drawing.new("Circle")
    sset(fovCirc,"Thickness",1) sset(fovCirc,"Transparency",1) sset(fovCirc,"Opacity",1)
    sset(fovCirc,"NumSides",40) sset(fovCirc,"Sides",40) sset(fovCirc,"Filled",false)
    sset(fovCirc,"Color",Color3.new(1,1,1)) sset(fovCirc,"Visible",false)
    if getgenv then table.insert(getgenv()._RF_DRAW, fovCirc) end
end) end
local R15 = {{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},{"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}}
local R6 = {{"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"}}
local function clearc(ch) if not ch then return end pcall(function() local h=ch:FindFirstChild("ESPChams") if h then h:Destroy() end local b=ch:FindFirstChild("ESPNameTag") if b then b:Destroy() end end) end
Players.PlayerRemoving:Connect(function(p) VisCache[p.UserId] = nil if p.Character then clearc(p.Character) end end)
local Lock = nil
local function validTarget(p)
    if not enemy(p) then return false end
    local ch = p.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not (ch and hum and hum.Health > 0 and ch:FindFirstChild("HumanoidRootPart") and ch:FindFirstChild("Head")) then return false end
    return true
end
local function bestTarget(myChar)
    local c = workspace.CurrentCamera
    if not c then return nil end
    if Lock and validTarget(Lock) then
        local ch = Lock.Character
        if not (State.AimWallCheck and not visCached(Lock, ch, myChar)) then
            local pos = aimPos(ch)
            if pos then
                local sp, on = w2s(pos)
                if on and (sp - c.ViewportSize/2).Magnitude <= State.FOV * 1.4 then return pos end
            end
        end
    end
    Lock = nil
    local center = c.ViewportSize / 2
    local bestPos, bestD = nil, State.FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if validTarget(p) then
            local ch = p.Character
            if State.AimWallCheck and not visCached(p, ch, myChar) then continue end
            local pos = aimPos(ch)
            if pos then
                local sp, on = w2s(pos)
                if on then
                    local d2 = (sp - center).Magnitude
                    if d2 <= bestD then bestPos, bestD = pos, d2 Lock = p end
                end
            end
        end
    end
    return bestPos
end

conn = RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local li, ci = 1, 1
    for _, p in ipairs(Players:GetPlayers()) do
        if not enemy(p) then
            if p.Character then clearc(p.Character) end
        else
            local ch = p.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            local head = ch and ch:FindFirstChild("Head")
            if not (ch and hum and hum.Health > 0 and hrp and head) then
                if ch then clearc(ch) end
            else
                local v = visCached(p, ch, myChar)
                local col = v and VIS or HID
                local d = myHRP and (myHRP.Position - hrp.Position).Magnitude or 0
                if State.Chams then
                    local hl = ch:FindFirstChild("ESPChams")
                    if not hl then
                        hl = Instance.new("Highlight") hl.Name = "ESPChams"
                        hl.FillTransparency = 0.5 hl.OutlineTransparency = 0
                        hl.OutlineColor = Color3.new(1,1,1)
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Adornee = ch hl.Parent = ch
                    end
                    if hl.FillColor ~= col then hl.FillColor = col end
                else local h = ch:FindFirstChild("ESPChams") if h then h:Destroy() end end
                if State.Name or State.Distance then
                    local bb = ch:FindFirstChild("ESPNameTag")
                    if not bb then
                        bb = Instance.new("BillboardGui") bb.Name = "ESPNameTag"
                        bb.Adornee = head bb.Size = UDim2.new(0,200,0,50)
                        bb.StudsOffset = Vector3.new(0,3,0)
                        bb.AlwaysOnTop = true bb.LightInfluence = 0 bb.Parent = ch
                        local n = Instance.new("TextLabel") n.Name="N" n.Size=UDim2.new(1,0,0.5,0)
                        n.BackgroundTransparency=1 n.Font=Enum.Font.GothamBold n.TextSize=13 n.TextStrokeTransparency=0 n.Parent=bb
                        local s = Instance.new("TextLabel") s.Name="D" s.Position=UDim2.new(0,0,0.5,0) s.Size=UDim2.new(1,0,0.5,0)
                        s.BackgroundTransparency=1 s.Font=Enum.Font.Gotham s.TextSize=12 s.TextStrokeTransparency=0 s.Parent=bb
                    end
                    local n, s = bb:FindFirstChild("N"), bb:FindFirstChild("D")
                    if n then
                        n.Visible = State.Name
                        if State.Name then n.Text = p.DisplayName .. " (@" .. p.Name .. ")" n.TextColor3 = col end
                    end
                    if s then
                        s.Visible = State.Distance
                        if State.Distance then s.Text = "[" .. math.floor(d) .. "m]" s.TextColor3 = col end
                    end
                else local b=ch:FindFirstChild("ESPNameTag") if b then b:Destroy() end end
                if hasD and State.Skeleton then
                    local set = ch:FindFirstChild("UpperTorso") and R15 or R6
                    for _, pr in ipairs(set) do
                        local a, b = ch:FindFirstChild(pr[1]), ch:FindFirstChild(pr[2])
                        local l = getline(li) li = li + 1
                        if l and a and b then
                            local pa, oa = w2s(a.Position) local pb, ob = w2s(b.Position)
                            if oa and ob then sset(l,"From",pa) sset(l,"To",pb) sset(l,"Color",col) sset(l,"Visible",true)
                            else sset(l,"Visible",false) end
                        elseif l then sset(l,"Visible",false) end
                        if li > 300 then break end
                    end
                end
                if hasD and State.HeadCircle then
                    local cc = getcirc(ci) ci = ci + 1
                    if cc then
                        local hp, on = w2s(head.Position)
                        if on and d > 0 then
                            sset(cc,"Position",hp) sset(cc,"Radius",math.clamp(1400/d,8,90)) sset(cc,"Color",col) sset(cc,"Visible",true)
                        else sset(cc,"Visible",false) end
                    end
                end
            end
        end
        if li > 300 or ci > 60 then break end
    end
    if hasD then
        for i=li,#lines do sset(lines[i],"Visible",false) end
        for i=ci,#circles do sset(circles[i],"Visible",false) end
        if not State.Skeleton then for _,l in pairs(lines) do sset(l,"Visible",false) end end
        if not State.HeadCircle then for _,c in pairs(circles) do sset(c,"Visible",false) end end
        local c = workspace.CurrentCamera
        if fovCirc and c then
            local show = State.ShowFOV and State.AimEnabled
            sset(fovCirc,"Visible",show)
            if show then sset(fovCirc,"Position",c.ViewportSize/2) sset(fovCirc,"Radius",State.FOV) end
        end
    end
    local c = workspace.CurrentCamera
    if State.AimEnabled and c and myChar then
        local held = (State.AimMode ~= "RMB") or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        if held then
            local t = bestTarget(myChar)
            if t then
                local alpha = 1 / math.clamp(State.Smoothness, 1, 20)
                c.CFrame = c.CFrame:Lerp(CFrame.new(c.CFrame.Position, t), alpha)
            end
        else Lock = nil end
    else Lock = nil end
end)
if getgenv then getgenv()._RF_CONN = conn end
