    -- RAGE/LEGIT resolvers (Legit = base sliders, Rage = Rage sliders).*
    function aimResFOV()
        if (Settings.AimMode or "Legit") == "Rage" then return Settings.AimRageFOV or 600 end
        return Settings.AimFOV or 120
    end
    function aimResSmooth()
        if (Settings.AimMode or "Legit") == "Rage" then
            local v = Settings.AimRageSmooth or 0
            if v > 1 then v = v / 100 end
            return v
        end
        return Settings.AimSmooth or 0.25
    end
    function aimResVis()
