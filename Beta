        end)
    end)

    local function silentWallClear(headPos, targetChar)
        if not silentResWall() then return true end
        local camera = Workspace.CurrentCamera
        if not camera then return true end
        local origin = camera.CFrame.Position
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { LocalPlayer.Character, targetChar }
        params.IgnoreWater = true
        local ok, hit = pcall(function()
            return Workspace:Raycast(origin, headPos - origin, params)
        end)
        if not ok then return true end
        return hit == nil
    end

    local function silentTarget()
        for i = #silentHeads, 1, -1 do
            if not silentHeads[i].Parent then
                silentHeadSet[silentHeads[i]] = nil
                table.remove(silentHeads, i)
            end
        end
        if silentCachedHead and not silentCachedHead.Parent then silentCachedHead = nil end
        if not Settings.SilentEnabled then
            silentAim.position, silentAim.instance, silentAim.hum = nil, nil, nil
            silentCachedHead = nil
            return
        end
        local now = tick()
        if now - silentCacheTime < SILENT_CACHE_TTL and silentCachedHead and silentCachedHead.Parent then
            silentAim.position = silentCachedHead.Position
            silentAim.instance = silentCachedHead
            return
        end
        local camera = Workspace.CurrentCamera
        if not camera then return end
        local center = camera.ViewportSize / 2
        local fov = silentResFOV() or math.huge
        local closestDist, closestPos, closestPart = math.huge, nil, nil
        for i = #silentHeads, 1, -1 do
            local part = silentHeads[i]
            local valid = true
            if not part.Parent then
                silentHeadSet[part] = nil
                table.remove(silentHeads, i)
                valid = false
            end
            local owner, char
            if valid then
                owner, char = silentPlayerFromHead(part)
                if owner == LocalPlayer or (char and LocalPlayer.Character and char == LocalPlayer.Character) then
                    valid = false
                end
            end
            if valid and Settings.SilentTeamCheck and owner then
                if owner.Team == LocalPlayer.Team and LocalPlayer.Team ~= nil then
                    valid = false
                end
            end
            if valid and char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then
                    valid = false
                end
            end
            local screenPos, onScreen
            if valid then
                screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
                if not onScreen or screenPos.Z <= 0 then
                    valid = false
                end
            end
            if valid then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                if dist > fov or dist >= closestDist then
                    valid = false
                else
                    if not silentWallClear(part.Position, char) then
                        valid = false
                    else
                        closestDist, closestPos, closestPart = dist, part.Position, part
                    end
                end
            end
        end
        silentCacheTime, silentCachedHead = now, closestPart
        silentAim.position, silentAim.instance = closestPos, closestPart
        silentAim.hum = nil
        if closestPart and closestPart.Parent then
            pcall(function() silentAim.hum = closestPart.Parent:FindFirstChildOfClass("Humanoid") end)
        end
    end

    local silentHook
    pcall(function()
        if typeof(hookmetamethod) == "function" and typeof(newcclosure) == "function" then
            silentHook = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                -- ANTI-KICK + ANTI-ABNORMAL: block Kick + abnormal snitch remotes (single hook, no overwrite).*
                do
                    local okM, m = pcall(getnamecallmethod)
                    if okM and type(m) == "string" then
                        if m == "Kick" then
                            return nil
                        elseif (m == "FireServer" or m == "InvokeServer" or m == "FireUnreliable") and typeof(self) == "Instance" then
                            local okN, nm = pcall(function() return self.Name end)
                            if okN and type(nm) == "string" then
                                if nm == "ModerationRemote" or (nm == "SCP096Target" and Settings.No096)
                                    or nm == "AbnormalDetected" or nm == "ClientAbnormal"
                                    or nm == "AntiCheat" or nm == "AntiExploit"
                                    or nm == "KickPlayer" or nm == "BanPlayer" then
                                    return nil
                                end
                            end
                        end
                    end
                end
                if not Settings.SilentEnabled or not silentAim.position or self ~= Workspace or getnamecallmethod():lower() ~= "raycast" then
                    return silentHook(self, ...)
                end
                local args = {...}
                local origin, direction, params = args[1], args[2], args[3]
                if typeof(params) ~= "RaycastParams" then
                    return silentHook(self, ...)
                end
                local group = params.CollisionGroup
                -- FIX: old code always skipped Default, so hitscan guns never redirected.
                if not Settings.SilentAllGroups then
                    if group ~= "ProjectileCollision" and group ~= "Default" then
                        return silentHook(self, ...)
                    end
                end
                -- FIX: only redirect long-range shots. Short probe raycasts (movement /
                -- ground checks, interaction prompts - a few studs) must pass through
                -- untouched, or walking breaks and the server sends you back.
                if typeof(direction) == "Vector3" and direction.Magnitude < 30 then
                    return silentHook(self, ...)
                end
                if not silentGroupsSeen[group] then
                    silentGroupsSeen[group] = true
                    print("[Silent] redirecting CollisionGroup: " .. tostring(group))
                end
                if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" then
                    local length = direction.Magnitude
                    -- DAMAGE FIX: never redirect stale/dead/degenerate targets (broke hits).*
                    local hum = silentAim.hum
                    local alive = true
                    if hum ~= nil then
                        local okH, hp = pcall(function() return hum.Health end)
                        alive = okH and hp > 0
                    end
                    local off = silentAim.position - origin
                    if length > 0 and alive and off.Magnitude >= 1 then
                        args[2] = off.Unit * length
                    else
                        return silentHook(self, ...)
                    end
                end
                return silentHook(self, table.unpack(args))
            end))
        end
    end)

