-- No Recoil (hooks WeaponSystem_Overhaul recoil() + Client.Core CustomKick).*
    -- Event-driven: scans on toggle/respawn/WeaponSystem rebuild + rare 30s net.*
    -- (No timer loop: the old 5s full-getgc scan caused the lag + output spam.)*
    local recoilHooks = {}
    local recoilFields = {}
    local recoilScanning = false

    local function recoilHooked(fn)
        for _, r in ipairs(recoilHooks) do
            if r.fn == fn then return true end
        end
        return false
    end

    local function recoilHookOne(fn)
        if #recoilHooks >= 12 then
            local dropped = table.remove(recoilHooks, 1)
            pcall(hookfunction, dropped.fn, dropped.orig)
        end
        local cloak = (typeof(newcclosure) == "function") and newcclosure(function() end) or function() end
        local ok, orig = pcall(hookfunction, fn, cloak)
        if ok and type(orig) == "function" then
            recoilHooks[#recoilHooks + 1] = {fn = fn, orig = orig}
            return true
        end
        return false
    end

    local function recoilFieldMod(t, k)
        for _, r in ipairs(recoilFields) do
            if r.t == t and r.k == k then return false end
        end
        if #recoilFields >= 4 then return false end
        local ok, orig = pcall(function() return t[k] end)
        if not ok or type(orig) ~= "function" then return false end
        pcall(function() t[k] = function() end end)
        recoilFields[#recoilFields + 1] = {t = t, k = k, orig = orig}
        return true
    end

    local function recoilRestore()
        for _, r in ipairs(recoilHooks) do
            pcall(hookfunction, r.fn, r.orig)
        end
        table.clear(recoilHooks)
        for _, r in ipairs(recoilFields) do
            pcall(function() r.t[r.k] = r.orig end)
        end
        table.clear(recoilFields)
    end

    local function recoilScanAndHook(reason)
        if recoilScanning then return end
        if not Settings.NoRecoilEnabled then return end
        if typeof(getgc) ~= "function" or typeof(hookfunction) ~= "function" then return end
        recoilScanning = true
        task.spawn(function()
            local newFn, newMod, scanned = 0, 0, 0
            local ok, gc = pcall(getgc)
            if ok and type(gc) == "table" then
                for i, fn in ipairs(gc) do
                    if i % 2000 == 0 then task.wait() end
                    if not Settings.NoRecoilEnabled then break end
                    if newFn >= 6 then break end
                    if type(fn) == "function" and not recoilHooked(fn) then
                        local okI, info = pcall(debug.getinfo, fn, "Sn")
                        if okI and info and type(info.name) == "string" then
                            local src = tostring(info.short_src or "")
if info.name == "recoil" and string.find(src, "WeaponSystem_Overhaul", 1, true) then
                                if recoilHookOne(fn) then newFn = newFn + 1 end
                            elseif Settings.NoRecoilKick and info.name == "CustomKick" then
                                if recoilHookOne(fn) then newFn = newFn + 1 end
                            else
                                local lname = string.lower(info.name)
                                local wsrc = string.find(src, "WeaponSystem", 1, true) or string.find(src, "Weapon", 1, true)
                                    or string.find(src, "Gun", 1, true) or string.find(src, "Firearm", 1, true)
                                    or string.find(src, "Viewmodel", 1, true) or string.find(src, "ViewModel", 1, true)
                                if wsrc and (string.find(lname, "recoil", 1, true) or string.find(lname, "kick", 1, true)) then
                                    if recoilHookOne(fn) then newFn = newFn + 1 end
                                end
                            end
                        end
                    end
                end
                scanned = #gc
            end
            local okT, gct = pcall(function() return getgc(true) end)
            if okT and type(gct) == "table" then
                for i, v in ipairs(gct) do
                    if i % 4000 == 0 then task.wait() end
                    if newMod >= 2 then break end
                    if type(v) == "table" then
                        local okF = pcall(function() return v.CustomKick end)
                        if okF and type(v.CustomKick) == "function" then
                            if recoilFieldMod(v, "CustomKick") then newMod = newMod + 1 end
                        end
                    end
                end
            end
            if newFn > 0 or newMod > 0 then
                print("[NoRecoil] scan (" .. tostring(reason) .. "): +" .. newFn .. " fns, +" .. newMod .. " fields (gc=" .. scanned .. ")")
            end
            recoilScanning = false
        end)
    end

