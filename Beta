    function applyVMImport()
        local function normId(v)
            local digits = string.match(tostring(v or ""), "(%d+)")
            if not digits or #digits < 3 then return nil end
            return "rbxassetid://" .. digits
        end
        local mesh = normId(Settings.VMMeshId)
        local tex = normId(Settings.VMTextureId)
        if not mesh and not tex then print("[GunImporter] paste a Mesh ID first") return end
        pcall(clearVMImportMeshes)
        pcall(applyVMRestore)
        local parts = {}
        pcall(function() parts = vmGunParts() end)
        if #parts == 0 then print("[GunImporter] no gun parts (equip a gun first)") return end
        local held = "?"
        pcall(function()
            local _, ch = getHumanoid()
            local t = ch and ch:FindFirstChildOfClass("Tool")
            if t then held = t.Name end
        end)
        local nMesh, nPart, nNew, nSkip = 0, 0, 0, 0
        for _, d in ipairs(parts) do
            if _G.__vmOrig[d] == nil then
                local o = { c = d.Color, m = d.Material, sz = d.Size }
                local sm0 = d:FindFirstChildOfClass("SpecialMesh")
                if sm0 then o.mesh = { id = sm0.MeshId, tex = sm0.TextureId, sc = sm0.Scale } end
                if d:IsA("MeshPart") then o.meshPart = { id = d.MeshId, tex = d.TextureId } end
                _G.__vmOrig[d] = o
            end
            pcall(function()
                local sm = d:FindFirstChildOfClass("SpecialMesh")
                if sm then
                    if mesh then sm.MeshId = mesh end
                    if tex then sm.TextureId = tex end
                    nMesh = nMesh + 1
                elseif d:IsA("MeshPart") then
                    if mesh then d.MeshId = mesh end
                    if tex then d.TextureId = tex end
                    nPart = nPart + 1
                else
                    -- plain Part with no mesh container: add one so the ID actually shows.*
                    local nm = Instance.new("SpecialMesh")
                    nm.MeshType = Enum.MeshType.FileMesh
                    if mesh then nm.MeshId = mesh end
                    if tex then nm.TextureId = tex end
                    nm:SetAttribute("__vmImp", true)
                    nm.Parent = d
                    nNew = nNew + 1
                end
            end)
        end
        print(string.format("[GunImporter] gun=%s mesh=%d meshpart=%d newmesh=%d (Reset restores)", tostring(held), nMesh, nPart, nNew))
        if typeof(saveConfig) == "function" then pcall(saveConfig) end
    end
