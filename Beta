    function saveConfig()
        if typeof(writefile) ~= "function" then return end
        pcall(function()
            local HttpService = game:GetService("HttpService")
            local data = {}
            for _, k in ipairs(CFG_KEYS) do data[k] = Settings[k] end
            if type(Settings.ItemCats) == "table" then
                data.ItemCats = {}
                for ck, cv in pairs(Settings.ItemCats) do data.ItemCats[ck] = cv end
            end
            writefile("retro-config.json", HttpService:JSONEncode(data))
            print("[Config] saved")
        end)
    end
    pcall(function()
        if typeof(isfile) == "function" and typeof(readfile) == "function" and isfile("retro-config.json") then
            local HttpService = game:GetService("HttpService")
            local data = HttpService:JSONDecode(readfile("retro-config.json"))
            if type(data) == "table" then
                for _, k in ipairs(CFG_KEYS) do
                    if data[k] ~= nil then Settings[k] = data[k] end
                end
                if type(data.ItemCats) == "table" and type(Settings.ItemCats) == "table" then
                    for ck, cv in pairs(data.ItemCats) do if Settings.ItemCats[ck] ~= nil then Settings.ItemCats[ck] = cv end end
                end
                print("[Config] autoloaded")
            end
        end
    end)
    end

    local function newLine(thickness) 
 
        local l = Drawing.new("Line") 
 
        l.Visible = false 
 
        l.Thickness = thickness or 1 
 
        l.Transparency = 1 
 
        return l 
 
    end 
 
    local function newText() 
 
        local t = Drawing.new("Text") 
 
        t.Visible = false 
 
        t.Center = true 
 
        t.Outline = true 
 
        t.OutlineColor = Color3.new(0, 0, 0) 
 
        t.Size = Settings.TextSize 
 
        t.Font = 2 
 
        return t 
 
    end 
 
    local function newCham()
        local h = Instance.new("Highlight")
        h.FillTransparency = 0.6
        h.OutlineTransparency = 0
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Enabled = false
        return h
    end
    local function newSquare() 
 
        local s = Drawing.new("Square") 
 
        s.Visible = false 
 
        s.Thickness = 1 
 
        s.Filled = false 
 
        s.Transparency = 1 
 
        return s 
 
    end 
 
