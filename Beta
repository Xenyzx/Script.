    -- ANTI-RUBBERBAND: the server owns the character and corrects impossible positions
    -- (~3s send-back after phasing). Verified live: no Position/Teleport/Kick remotes to
    -- hook, and ElevatorTeleport is server->client only. So no client hook can fully
    -- bypass it. Best-effort mitigation: blink-step travel (small replicated steps,
    -- velocity zeroed, streaming keeps up) + velocity damping while phased (see
    -- playerConn). Instant long-range CFrame sets still snap back sometimes - use the
    -- Travel TP buttons instead of manual far teleports.
    -- Dual mode: far = walk-plausible cruise (WalkSpeed capped at 22/s, the "vector
    -- goto"); near (<=150st) = blink finish. Retarget-safe: pressing TP mid-trip
    -- only retargets, and trips end with a 5s cooldown, so button spam cannot stack
    -- impossible positions (that stacking is what earns the kick).
    local travelToken = 0
    local travelBusy = false
    local travelCooldownUntil = 0
    local function travelCancel(cooldown)
        travelToken = travelToken + 1
        travelBusy = false
        travelCooldownUntil = tick() + (cooldown or 1.5)
    end
    local function travelToPosition(dest, fast, force)
        if typeof(dest) ~= "Vector3" then return end
        if travelBusy then
            travelToken = travelToken + 1 -- retarget in flight, no jump stacked
        end
        if tick() < travelCooldownUntil then if force then print("[TP] cooling down") end return end
        -- FIX: gates proved instant sticks same-level (old behavior); 914/035 need
        -- cruise. Auto = instant when close and flat, else cruise.
        local hum0, char0 = getHumanoid()
        local hrp0 = char0 and char0:FindFirstChild("HumanoidRootPart")
        if not hum0 or not char0 or not hrp0 then return end
        local dist0 = (dest - hrp0.Position).Magnitude
        local dy0 = math.abs(dest.Y - hrp0.Position.Y)
        local mode = Settings.TPMode or "Auto"
        if force or (mode ~= "Cruise" and not (mode == "Auto" and (dist0 > 400 or dy0 > 100))) then
            travelToken = travelToken + 1
            pcall(function()
                pcall(applyNoclipToChar, char0)
                hrp0.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp0.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                hrp0.CFrame = CFrame.new(dest + Vector3.new(0, 3, 0), dest + Vector3.new(0, 3, 0) + Camera.CFrame.LookVector)
            end)
            travelBusy = false
            if not fast then travelCooldownUntil = tick() + 5 end
            if force then
                local fd = dest
                task.delay(1.5, function()
                    local humV, charV = getHumanoid()
                    local hrpV = charV and charV:FindFirstChild("HumanoidRootPart")
                    if humV and hrpV and humV.Health > 0 and (hrpV.Position - fd).Magnitude > 60 then
                        print("[TP] snapped back, cruising instead")
                        travelToPosition(fd)
                    elseif humV and hrpV then
                        print("[TP] arrived")
                    end
                end)
            end
            return
        end
        travelToken = travelToken + 1
        travelBusy = true
        local my = travelToken
        task.spawn(function()
            local step = math.clamp(Settings.BlinkStep or 35, 10, 60)
            local cruise = math.clamp(math.min(Settings.WalkSpeed or 16, 22), 8, 22)
            local guard = 0
            while my == travelToken and guard < 20000 do
                guard = guard + 1
                local hum, char = getHumanoid()
                if not hum or not char or hum.Health <= 0 then break end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then break end
                local target = dest + Vector3.new(0, 3, 0)
                local delta = target - hrp.Position
                local dist = delta.Magnitude
                if dist <= 4 then break end
                pcall(applyNoclipToChar, char)
                local dt = RunService.Heartbeat:Wait()
                if my ~= travelToken then break end
                if typeof(dt) ~= "number" or dt <= 0 or dt > 0.25 then dt = 1/60 end
                local dir = delta.Unit
                local d
                if dist > 150 then
                    d = math.min(cruise * dt, dist) -- walk-plausible cruise
                else
                    d = math.min(step, dist) -- short-hop blink finish
                end
                pcall(function()
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    hrp.CFrame = CFrame.new(hrp.Position + dir * d, hrp.Position + dir * d + Camera.CFrame.LookVector)
                end)
            end
            local hum2, char2 = getHumanoid()
            if hum2 and char2 then
                local hrp2 = char2:FindFirstChild("HumanoidRootPart")
                if hrp2 then pcall(function()
                    hrp2.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    hrp2.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end) end
            end
            if my == travelToken then
                travelBusy = false
                travelCooldownUntil = tick() + 5
            end
        end)
    end
