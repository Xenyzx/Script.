                    if Settings.Fullbright then pcall(function() applyFullbright(true) end) else pcall(function() applyFullbright(false) end) end
                    if Settings.NoRecoilEnabled then pcall(function() applyNoRecoil(true) end) end
                    pcall(applyGun)
                    pcall(applyCam)
                    if Settings.AimMobileButton then pcall(createMobileButton) else pcall(destroyMobileButton) end
                    ok = true
                end
