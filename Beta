    local silentAim = {position = nil, instance = nil} 
    local silentGroupsSeen = {}
    local silentHeads, silentHeadSet = {}, {}
    local silentCachedHead, silentCacheTime = nil, 0
    local SILENT_CACHE_TTL = 0.08

    local function silentIsSelf(part)
        local char = LocalPlayer.Character
        return char and part:IsDescendantOf(char)
    end

    local function silentPlayerFromHead(part)
        local char = part:FindFirstAncestorOfClass("Model")
        if char then
            local ok, plr = pcall(function() return Players:GetPlayerFromCharacter(char) end)
            if ok and plr then return plr, char end
            for _, plr2 in ipairs(Players:GetPlayers()) do
                local c = plr2.Character
                if c and (char == c or part:IsDescendantOf(c)) then
                    return plr2, c
                end
            end
            return nil, char
        end
        for _, plr2 in ipairs(Players:GetPlayers()) do
            local c = plr2.Character
            if c and part:IsDescendantOf(c) then
                return plr2, c
            end
        end
        return nil, nil
    end

    -- Silent hitscan: Head only, or Head+Torso+limbs (Epsilon-style Hitscan list).*
    local silentHitParts = { Head = true }
    local function silentTrackHead(part)
        if part:IsA("BasePart") and silentHitParts[part.Name] and not silentHeadSet[part] and not silentIsSelf(part) then
            silentHeadSet[part] = true
            silentHeads[#silentHeads + 1] = part
        end
    end
    local function rescanHeads()
        for _, part in ipairs(Workspace:GetDescendants()) do
            pcall(silentTrackHead, part)
        end
    end

    local function silentRemoveHead(part)
        if silentHeadSet[part] then
            silentHeadSet[part] = nil
            for i = #silentHeads, 1, -1 do
                if silentHeads[i] == part then
                    table.remove(silentHeads, i)
                    break
                end
            end
            if silentCachedHead == part then
                silentCachedHead = nil
                silentAim.position, silentAim.instance, silentAim.hum = nil, nil, nil
            end
        end
    end

    for _, part in ipairs(Workspace:GetDescendants()) do
        silentTrackHead(part)
    end

    local silentAddedConn = Workspace.DescendantAdded:Connect(silentTrackHead)
    local silentRemovedConn = Workspace.DescendantRemoving:Connect(silentRemoveHead)
    local silentCharConn = LocalPlayer.CharacterAdded:Connect(function(char)
        task.defer(function()
            for i = #silentHeads, 1, -1 do
                local h = silentHeads[i]
                if not h.Parent or h:IsDescendantOf(char) then
