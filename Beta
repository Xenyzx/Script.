    local function travelToCached(key, force)
        -- Explicit button press: drop any in-flight trip + cooldown so it always fires.*
        if force then
            travelToken = travelToken + 1 travelBusy = false travelCooldownUntil = 0
        end
        -- Static teleports (Exit/Armory) bypass the marker cache entirely.*
        if travelStatic[key] then travelToPosition(travelStatic[key], nil, force) return end
        local info = locationCache[key]
        if not info or not info.object or not info.object.Parent then
            pcall(resolveDirectTargets)
            info = locationCache[key]
        end
        -- FIX: TP must work even if the marker toggle is off: resolve direct, toggle-independent.
        if (not info or not info.object or not info.object.Parent) and travelDirectPaths[key] then
            for _, dp in ipairs(travelDirectPaths[key]) do
                local o = findDirect(dp)
                if o and cacheIfLive(key, o, 3) then info = locationCache[key] break end
            end
        end
        if info and info.object and info.object.Parent then
            -- SCP-914: exact GetPivot() * CFrame.new(20,0,0) from working script.*
            if key == "SCP-914" then
                local okC, cf = pcall(function()
                    local o = info.object
                    if o:IsA("Model") then return o:GetPivot()
                    elseif o:IsA("BasePart") then return o.CFrame
                    else
                        local okP2, pp = pcall(getLocationPosition, o)
                        if okP2 and pp then return CFrame.new(pp) end
                        return nil
                    end
                end)
                if okC and cf then
                    local dest = (cf * CFrame.new(20, 0, 0)).Position
                    print("[TP] going: SCP-914 (pivot+20)")
                    travelToPosition(dest, nil, force)
                    return
                end
            end
            -- SCP-035: Systems.MainMask + Systems.Model.Part fallbacks, CFrame.new(3,-3,0).*
            if key == "SCP-035" then
                local dest035 = nil
                pcall(function()
                    local base = info.object
                    local cands = {}
                    if base and base.Parent then
                        -- try Systems.MainMask under the room
                        local sys = base:FindFirstChild("Systems")
                        if sys then
                            local mm = sys:FindFirstChild("MainMask")
                            if mm then cands[#cands + 1] = mm end
                            local mdl = sys:FindFirstChild("Model")
                            if mdl then
                                local pt = mdl:FindFirstChild("Part")
                                if pt then cands[#cands + 1] = pt else cands[#cands + 1] = mdl end
                            end
                        end
                        local mm2 = base:FindFirstChild("MainMask", true)
                        if mm2 then cands[#cands + 1] = mm2 end
                        cands[#cands + 1] = base
                    end
                    for _, c in ipairs(cands) do
                        local cf2 = nil
                        if c:IsA("Model") then cf2 = c:GetPivot()
                        elseif c:IsA("BasePart") then cf2 = c.CFrame
                        elseif c:IsA("Attachment") then cf2 = CFrame.new(c.WorldPosition) end
                        if cf2 then dest035 = (cf2 * CFrame.new(3, -3, 0)).Position break end
                    end
                end)
                if dest035 then
                    print("[TP] going: SCP-035 (mask+3,-3,0)")
                    travelToPosition(dest035, nil, force)
                    return
                end
            end
            local okP, pos = pcall(getLocationPosition, info.object)
            if okP and pos then print("[TP] going: " .. tostring(key)) travelToPosition(pos, nil, force) return end
        end
        if key == "Mask" then print("[TP] Mask gone (taken or round not started)") end
        print("[TP] " .. tostring(key) .. " not found, rescanning...")
        pcall(fullScanSCP)
    end
