    -- SCP LOCATION ESP (event-driven: one chunked scan on enable, then DescendantAdded upkeep.*
    -- Old version re-scanned Workspace:GetDescendants() + GetPivot() on every object twice a second = lag spikes.*
    local locationDraws = {}
    local locationCache = {}
