    local locationLastEmptyScan = 0

    local function getLocationPosition(obj)
        if obj:IsA("BasePart") then return obj.Position end
        if obj:IsA("Model") then
            local ok, piv = pcall(function() return obj:GetPivot() end)
            if ok and piv then return piv.Position end
            return nil
        end
        if obj:IsA("Attachment") then return obj.WorldPosition end
        -- Folders (e.g. Facility Warhead Terminals): anchor on first BasePart.*
        local okF, first = pcall(function() return obj:FindFirstChildWhichIsA("BasePart", true) end)
        if okF and first then return first.Position end
        return nil
    end

    -- Cheap name gate first (substring + length) so ~99% of objects skip the gsub.*
local function scpKeyForName(raw)
        if type(raw) ~= "string" then return nil end
        if #raw < 3 or #raw > 60 then return nil end
        local n = string.lower(raw):gsub("[%s_%-]", "")
        if n == "914" or n == "scp914" then return "SCP-914", 2 end
        if n == "035" or n == "scp035" then return "SCP-035", 2 end
        -- Long descriptive names (e.g. "SCP-035 Containment Chamber") never matched exact: accept contains.*
        if #raw <= 40 then
            if string.find(n, "scp914", 1, true) or string.find(n, "914", 1, true) then
                return "SCP-914", 1
            end
            if string.find(n, "scp035", 1, true) or string.find(n, "035", 1, true) then
                return "SCP-035", 1
            end
        end
        return nil
    end

    local function scpScore(obj)
        if obj:IsA("Model") then return 1e12 end
        if obj:IsA("BasePart") then
            local s = obj.Size
            return s.X * s.Y * s.Z
        end
        return 1
    end

    local spawnPosList = {}

    -- Penalty words = spawn/showcase area, bonus words = real containment rooms.*
    local function scpAreaFlags(obj)
        local pen, bon = 0, 0
        local par = obj.Parent
        for _ = 1, 6 do
            if not par then break end
            local okN, nm = pcall(function() return par.Name end)
            if okN and type(nm) == "string" then
                local n = string.lower(nm)
                if string.find(n, "spawn", 1, true) or string.find(n, "lobby", 1, true)
                    or string.find(n, "showcase", 1, true) or string.find(n, "showroom", 1, true)
                    or string.find(n, "display", 1, true) or string.find(n, "pedestal", 1, true)
                    or string.find(n, "menu", 1, true) or string.find(n, "queue", 1, true)
                    or string.find(n, "vote", 1, true) then
                    pen = pen + 1
                end
                if string.find(n, "contain", 1, true) or string.find(n, "chamber", 1, true)
                    or string.find(n, "facility", 1, true) or string.find(n, "zone", 1, true)
                    or string.find(n, "sector", 1, true) then
                    bon = bon + 1
                end
            end
            par = par.Parent
        end
        return pen, bon
    end

    local function scpIsBetter(newObj, nq, curObj, cq)
        -- FIX: anything under Workspace.Map.Dynamic beats Lobby/showcase copies outright.
        local okN2, nf = pcall(function() return string.lower(newObj:GetFullName()) end)
        local okC2, cf = pcall(function() return string.lower(curObj:GetFullName()) end)
        if okN2 and okC2 then
            local nd = string.find(nf, "map.dynamic", 1, true) ~= nil
            local cd = string.find(cf, "map.dynamic", 1, true) ~= nil
            if nd ~= cd then return nd end
        end
        if nq ~= cq then return nq > cq end
        local np, nb = scpAreaFlags(newObj)
        local cp, cb = scpAreaFlags(curObj)
        if np ~= cp then return np < cp end
        if nb ~= cb then return nb > cb end
        -- Showcase sits at spawn: all else equal, farther from spawn wins.*
        local okN, npos = pcall(getLocationPosition, newObj)
        local okC, cpos = pcall(getLocationPosition, curObj)
        if okN and okC and npos and cpos and #spawnPosList > 0 then
            local nd, cd = math.huge, math.huge
            for _, sp in ipairs(spawnPosList) do
                local d1 = (sp - npos).Magnitude
                if d1 < nd then nd = d1 end
                local d2 = (sp - cpos).Magnitude
                if d2 < cd then cd = d2 end
            end
            if math.abs(nd - cd) > 30 then return nd > cd end
        end
        return scpScore(newObj) > scpScore(curObj)
    end

    -- FIX: decoy blacklist from live map scan. Real rooms live under Workspace.Map.Dynamic
    -- (LCZ.#914, HCZ.#035). Lobby/SCPInfo/ReplicatedStorage/GUIs/Shop hold showcase
    -- copies that sit at spawn - matching those is what pinned 035 to spawn.
    local scpBadSubs = {"lobby","scpinfo","replicatedstorage","startergui","playergui","coregui","shop","skins","characters","notused","backup"}
    local function scpBadPath(obj)
        local okF, full = pcall(function() return string.lower(obj:GetFullName()) end)
        if not okF or type(full) ~= "string" then return false end
        for _, s in ipairs(scpBadSubs) do
            if string.find(full, s, 1, true) then return true end
        end
        return false
    end

    local function scpConsider(obj)
        if obj.ClassName == "SpawnLocation" then
            if #spawnPosList < 32 then
                local okS, sp = pcall(function() return obj.Position end)
                if okS and sp then
                    local dup = false
                    for _, e in ipairs(spawnPosList) do
                        if (e - sp).Magnitude < 5 then dup = true break end
                    end
                    if not dup then spawnPosList[#spawnPosList + 1] = sp end
                end
            end
            return
        end
        -- LAG FIX: cheap name gate first; GetFullName (scpBadPath) only runs for real candidates.*
        local okName, nm = pcall(function() return obj.Name end)
        if not okName then return end
        local key, quality = scpKeyForName(nm)
        if not key then return end
        if key == "SCP-914" and not Settings.Location914Enabled then return end
        if key == "SCP-035" and not Settings.Location035Enabled then return end
        local okType, isGood = pcall(function()
            return obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Attachment")
        end)
        if not okType or not isGood then return end
        if scpBadPath(obj) then return end
        -- Never track player characters or worn/carried items.*
        local okC, isChar = pcall(function()
            local m = obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model")
            return m and m:FindFirstChildOfClass("Humanoid") ~= nil
        end)
        if okC and isChar then return end
        local cur = locationCache[key]
        if not cur or not cur.object or not cur.object.Parent then
            locationCache[key] = {object = obj, q = quality}
        else
            local okB, better = pcall(scpIsBetter, obj, quality, cur.object, cur.q or 0)
            if okB and better then locationCache[key] = {object = obj, q = quality} end
        end
    end

    local function clearLocationDraws()
        for key, d in pairs(locationDraws) do
            pcall(function() d.text:Remove() end)
            pcall(function() d.dot:Remove() end)
            locationDraws[key] = nil
        end
        table.clear(locationCache)
    end

