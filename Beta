    -- CHAR RESOLVE: game often leaves player.Character nil (morphs/custom spawns) while the
    -- model lives at Workspace.PlayerName (verified live). Fall back to name lookup.*
    -- (Defined early: ESP/aimbot reference it before the movement section.)*
    local function getChar(plr)
        if not plr then return nil end
        local c = plr.Character
        if c and c.Parent then return c end
        local ok, m = pcall(function() return Workspace:FindFirstChild(plr.Name) end)
        if ok and m and m:IsA("Model") then return m end
        return nil
    end
    local function createESP(player) 
 
        if ESP[player] then return end 
 
        ESP[player] = { 
 
            box        = newSquare(), 
 
            name       = newText(), 
 
            distance   = newText(), 
 
            tracer     = newLine(1), 
 
            hpBg       = newSquare(), 
 
            hpFill     = newSquare(), 

            sk1        = newLine(1), 

            sk2        = newLine(1), 

            sk3        = newLine(1), 

            sk4        = newLine(1), 

            sk5        = newLine(1), 

            cham       = newCham(), 

            inv        = newText(),

        }
 
        ESP[player].hpBg.Filled = true 
 
        ESP[player].hpBg.Color = Color3.new(0, 0, 0) 
 
        ESP[player].hpFill.Filled = true 
 
    end 
 
    local function destroyESP(player) 
 
        local e = ESP[player] 
 
        if not e then return end 
 
        for _, d in pairs(e) do 
 
            pcall(function() d:Remove() end) 
 
        end 
 
        ESP[player] = nil
        lastSeen[player] = nil 
 
    end 
 
