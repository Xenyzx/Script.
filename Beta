                    local t = Drawing.new("Text")
                    t.Center = true t.Outline = true t.Size = 13 t.Font = 2 t.Visible = false
                    t.Color = Color3.fromRGB(255, 80, 80)
                    local dot = Drawing.new("Square")
                    dot.Filled = true dot.Size = Vector2.new(6, 6) dot.Visible = false
                    dot.Color = Color3.fromRGB(255, 80, 80)
                    local traj = newLine(1)
                    traj.Color = Color3.fromRGB(255, 120, 60)
                    local imp = Drawing.new("Square")
                    imp.Filled = true imp.Size = Vector2.new(8, 8) imp.Visible = false
                    imp.Color = Color3.fromRGB(255, 200, 60)
                    grenadeDraws[obj] = { text = t, dot = dot, traj = traj, imp = imp }
                end
            end
        end
        for obj, d in pairs(grenadeDraws) do
            local ok = false
            repeat
                if not obj.Parent then break end
                local pos
                do local okP, p = pcall(function() return obj.Position end) if not okP then break end pos = p end
                local dist = (Camera.CFrame.Position - pos).Magnitude
                if dist > (Settings.GrenadeMaxDist or 1000) then break end
                local sp, on = Camera:WorldToViewportPoint(pos)
                if not on then break end
                ok = true
                d.dot.Visible = true d.dot.Position = Vector2.new(sp.X - 3, sp.Y - 3)
                d.text.Visible = true d.text.Text = string.format("GRENADE [%dm]", math.floor(dist))
                d.text.Position = Vector2.new(sp.X, sp.Y - 18)
                -- trajectory + impact prediction
                local vel = Vector3.new(0, 0, 0)
                pcall(function()
                    if obj.AssemblyLinearVelocity then vel = obj.AssemblyLinearVelocity
                    elseif obj.Velocity then vel = obj.Velocity end
                end)
                if vel.Magnitude > 2 then
                    local tFly = 0.8
                    local pred = pos + vel * tFly + Vector3.new(0, -0.5 * 196.2 * tFly * tFly, 0)
                    local impact = pred
                    pcall(function()
                        local rp = RaycastParams.new()
                        rp.FilterType = Enum.RaycastFilterType.Exclude
                        rp.FilterDescendantsInstances = { obj }
                        rp.IgnoreWater = true
                        local hit = Workspace:Raycast(pred + Vector3.new(0, 5, 0), Vector3.new(0, -40, 0), rp)
                        if hit and hit.Position then impact = hit.Position end
                    end)
                    local sp2, on2 = Camera:WorldToViewportPoint(pred)
                    local spI, onI = Camera:WorldToViewportPoint(impact)
                    if on2 then
                        d.traj.Visible = true d.traj.From = Vector2.new(sp.X, sp.Y) d.traj.To = Vector2.new(sp2.X, sp2.Y)
                    else d.traj.Visible = false end
                    if onI then
                        d.imp.Visible = true d.imp.Position = Vector2.new(spI.X - 4, spI.Y - 4)
                    else d.imp.Visible = false end
                else
                    d.traj.Visible = false d.imp.Visible = false
                end
            until true
            if not ok then d.text.Visible = false d.dot.Visible = false d.traj.Visible = false d.imp.Visible = false end
        end
    end)
