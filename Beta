    local function getColor(player) 

        if Settings.TeamColors then 

            local team = player.Team 

            if team then 

                local fix = teamColorFix[team.Name]
                if fix then return fix end
                return team.TeamColor.Color
 
            end 
 
            return Color3.new(1, 1, 1) 
 
        else 
 
            if player.Team == LocalPlayer.Team and LocalPlayer.Team ~= nil then 
 
                return Settings.AllyColor 
 
            end 
 
            return Settings.EnemyColor 
 
        end 
 
    end 
 
    local function tracerOrigin() 
 
        if Settings.TracerFrom == "Center" then 
 
            return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2) 
 
        elseif Settings.TracerFrom == "Mouse" then 
 
            local m = LocalPlayer:GetMouse() 
 
            return Vector2.new(m.X, m.Y) 
 
        else 

            return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y) 

        end 

    end 

    -- INVENTORY ESP: equipped + backpack tools as color-coded hotbar line above player.*
    invCatColor = {
        Weapons = Color3.fromRGB(255, 170, 60),
        Grenades = Color3.fromRGB(255, 80, 80),
        Medical = Color3.fromRGB(90, 255, 120),
        Keycards = Color3.fromRGB(80, 200, 255),
        Utility = Color3.fromRGB(255, 230, 90),
        Ammo = Color3.fromRGB(200, 200, 200),
        SCP = Color3.fromRGB(225, 90, 255),
    }
    function invClassify(n)
        local s = string.lower(tostring(n or ""))
        if string.find(s, "scp", 1, true) then return "SCP" end
        if string.find(s, "ammo", 1, true) then return "Ammo" end
        if string.find(s, "card", 1, true) then return "Keycards" end
        if string.find(s, "grenade", 1, true) or string.find(s, "flash", 1, true) then return "Grenades" end
        if string.find(s, "medkit", 1, true) or string.find(s, "bandage", 1, true) or string.find(s, "cola", 1, true) or string.find(s, "pill", 1, true) then return "Medical" end
        return "Weapons"
    end
    function getPlayerLoadout(player, char)
        local held, bag = nil, {}
        pcall(function()
            if char then
                local t = char:FindFirstChildOfClass("Tool")
                if t then held = t.Name end
            end
        end)
        pcall(function()
            local bp = player:FindFirstChildOfClass("Backpack")
            if bp then
                for _, t in ipairs(bp:GetChildren()) do
                    if t:IsA("Tool") and t.Name ~= held and #bag < 5 then
                        bag[#bag + 1] = t.Name
                    end
                end
            end
        end)
        if not held and #bag == 0 then return nil, nil end
        local txt = (held or "Hands")
        if #bag > 0 then txt = txt .. " | " .. table.concat(bag, ", ") end
        if #txt > 48 then txt = string.sub(txt, 1, 48) .. ".." end
        local cat = invClassify(held or bag[1] or "")
        return txt, (invCatColor[cat] or Color3.fromRGB(255, 255, 255))
    end

    local function updateESP()
 
        for player, e in pairs(ESP) do 
 
            local ok = false 
 
            repeat 
 
                if not Settings.Enabled then break end 
 
                if player == LocalPlayer then break end 
 
                local char = getChar(player) 
 
                if not char then break end 
 
                local root = char:FindFirstChild("HumanoidRootPart") 

                local humanoid = char:FindFirstChildOfClass("Humanoid") 

                if not root or not humanoid then break end
                if humanoid.Health <= 0 then
                    -- DEAD: show [DEAD] tag at corpse (fixed from "?").*
                    pcall(function()
                        local rp, on2 = Camera:WorldToViewportPoint(root.Position)
                        if on2 and Settings.Enabled then
                            e.name.Visible = true
                            e.name.Color = Color3.fromRGB(150, 150, 150)
                            e.name.Size = Settings.TextSize
                            e.name.Text = (player.DisplayName ~= "" and player.DisplayName or player.Name) .. " [DEAD]"
                            e.name.Position = Vector2.new(rp.X, rp.Y - 16)
                            e.distance.Visible = true
                            e.distance.Color = Color3.fromRGB(150, 150, 150)
                            e.distance.Size = Settings.TextSize
                            e.distance.Text = "[DEAD]"
                            e.distance.Position = Vector2.new(rp.X, rp.Y)
                        end
                    end)
                    break
                end
 
                local sameTeam = (player.Team == LocalPlayer.Team and LocalPlayer.Team ~= nil) 
 
                if sameTeam and not Settings.ShowTeam then break end 
 
                local dist = (Camera.CFrame.Position - root.Position).Magnitude 
 
                if dist > Settings.MaxDistance then break end 
 
                local rootPos, onScreen = Camera:WorldToViewportPoint(root.Position) 
 
                if not onScreen then break end 
 
                local headPos = (char:FindFirstChild("Head") and char.Head.Position) 
 
                    or (root.Position + Vector3.new(0, 2.5, 0)) 
 
                local topV    = Camera:WorldToViewportPoint(headPos + Vector3.new(0, 0.5, 0)) 
 
                local botV    = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0)) 
 
                local height = math.abs(topV.Y - botV.Y) 
 
                local width  = height * 0.55 
 
                local x      = rootPos.X - width / 2 
 
                local y      = topV.Y 
 
                local color = getColor(player) 

                ok = true 

                lastSeen[player] = { pos = root.Position, t = tick() }
 
                if Settings.Box then 
 
                    e.box.Visible = true 
 
                    e.box.Color = color 
 
                    e.box.Size = Vector2.new(width, height) 
 
                    e.box.Position = Vector2.new(x, y) 
 
                else 
 
                    e.box.Visible = false 
 
                end 
 
                if Settings.Healthbar then 
 
                    local hp = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1) 
 
                    local barH = height 
 
                    local barX = x - 5 
 
                    e.hpBg.Visible = true 
 
                    e.hpBg.Size = Vector2.new(3, barH) 
 
                    e.hpBg.Position = Vector2.new(barX, y) 
 
                    e.hpFill.Visible = true 
 
                    e.hpFill.Size = Vector2.new(3, barH * hp) 
 
                    e.hpFill.Position = Vector2.new(barX, y + barH * (1 - hp)) 
 
                    e.hpFill.Color = Color3.fromRGB(255 - math.floor(255 * hp), math.floor(255 * hp), 60) 
 
                else 
 
                    e.hpBg.Visible = false 
 
                    e.hpFill.Visible = false 
 
                end 
 
                if Settings.Name then 
 
                    e.name.Visible = true 
 
                    e.name.Color = color 
 
                    e.name.Size = Settings.TextSize 
 
                    e.name.Text = player.DisplayName ~= "" and player.DisplayName or player.Name 
 
                    e.name.Position = Vector2.new(rootPos.X, y - 16) 
 
                else 
 
                    e.name.Visible = false 
 
                end 
 
                if Settings.Distance then 
 
                    e.distance.Visible = true 
 
                    e.distance.Color = color 
 
                    e.distance.Size = Settings.TextSize 
 
                    local teamName = player.Team and player.Team.Name or "Neutral" 
 
                    e.distance.Text = string.format("[%s] %dm", teamName, math.floor(dist)) 
 
                    e.distance.Position = Vector2.new(rootPos.X, y + height + 2) 
 
                else 

                    e.distance.Visible = false 

                end 

                -- INVENTORY HOTBAR above name (equipped + backpack, category-colored).*
                do
                    local showInv = Settings.InvESP ~= false
                    if showInv then
                        local okI, itxt, icol = pcall(getPlayerLoadout, player, char)
                        if okI and itxt then
                            e.inv.Visible = true
                            e.inv.Color = icol or color
                            e.inv.Size = math.max(11, (Settings.TextSize or 13) - 1)
                            e.inv.Text = "[" .. itxt .. "]"
                            e.inv.Position = Vector2.new(rootPos.X, y - 30)
                        else
                            e.inv.Visible = false
                        end
                    else
                        e.inv.Visible = false
                    end
                end

                if Settings.Tracer then
 
                    e.tracer.Visible = true 
 
                    e.tracer.Color = color 
 
                    e.tracer.From = tracerOrigin() 
 
                    e.tracer.To = Vector2.new(rootPos.X, y + height) 

                else 

                    e.tracer.Visible = false 

                end 

                -- SKELETON ESP (R6 joints; per-bone visibility so partial cover still draws).*
                if Settings.Skeleton then 
                    local bp = {
                        Head = char:FindFirstChild("Head"),
                        Torso = char:FindFirstChild("Torso"),
                        LA = char:FindFirstChild("Left Arm"),
                        RA = char:FindFirstChild("Right Arm"),
                        LL = char:FindFirstChild("Left Leg"),
                        RL = char:FindFirstChild("Right Leg"),
                    }
                    local function skPos(p)
                        if not p then return nil end
                        local v, on = Camera:WorldToViewportPoint(p.Position)
                        if not on then return nil end
                        return Vector2.new(v.X, v.Y)
                    end
                    local bones = { {"Head", "Torso"}, {"Torso", "LA"}, {"Torso", "RA"}, {"Torso", "LL"}, {"Torso", "RL"} }
                    local skLines = { e.sk1, e.sk2, e.sk3, e.sk4, e.sk5 }
                    for i, b in ipairs(bones) do
                        local a = bp[b[1]] and skPos(bp[b[1]])
                        local c2 = bp[b[2]] and skPos(bp[b[2]])
                        local ln = skLines[i]
                        if a and c2 then
                            ln.Visible = true ln.Color = color ln.From = a ln.To = c2
                        else
                            ln.Visible = false
                        end
                    end
                else 
                    e.sk1.Visible = false e.sk2.Visible = false e.sk3.Visible = false e.sk4.Visible = false e.sk5.Visible = false
                end
                -- CHAMS: Highlight through walls, team-colored.*
                if Settings.Chams then
                    pcall(function()
                        e.cham.Adornee = char
                        e.cham.Enabled = true
                        e.cham.FillColor = color
                        e.cham.OutlineColor = color
                    end)
                else
                    pcall(function() e.cham.Enabled = false end)
                end
 
            until true 
 
            if not ok then 

                hideESP(e) 

                -- LAST-SEEN: streamed-out players keep a faded tag at last pos (<30s).*
                if Settings.Enabled then
                    local ls = lastSeen[player]
                    if ls and tick() - ls.t < 30 then
                        local sp, on = Camera:WorldToViewportPoint(ls.pos)
                        if on and sp.Z > 0 then
                            e.name.Visible = true
                            e.name.Color = Color3.fromRGB(150, 150, 150)
                            e.name.Size = Settings.TextSize
                            e.name.Text = (player.DisplayName ~= "" and player.DisplayName or player.Name) .. " [DEAD]"
                            e.name.Position = Vector2.new(sp.X, sp.Y - 16)
                            e.distance.Visible = true
                            e.distance.Color = Color3.fromRGB(150, 150, 150)
                            e.distance.Size = Settings.TextSize
                            e.distance.Text = "[DEAD]"
                            e.distance.Position = Vector2.new(sp.X, sp.Y)
                        end
                    end
                end

            end
 
        end 
 
    end 
 
