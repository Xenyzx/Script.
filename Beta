    function applyGun()
        local ch = LocalPlayer.Character
        if ch then
            pcall(function()
                if Settings.NoRecoilEnabled then ch:SetAttribute("Recoil_Control", 1) else ch:SetAttribute("Recoil_Control", 0) end
            end)
        end
        if not Settings.NoRecoilEnabled and not Settings.FullAuto and not Settings.InstReload and not Settings.NoSpread and (Settings.FireRateVal or 700) == 700 then
            for _, t in ipairs(gunTables) do
                pcall(function()
                    if rawget(t, "__stockRate") ~= nil then t.FireRate = rawget(t, "__stockRate") end
                    if rawget(t, "__stockMode") ~= nil then t.FireMode = rawget(t, "__stockMode") end
                    if rawget(t, "__stockSpread") ~= nil then t.Spread = rawget(t, "__stockSpread") end
                end)
            end
            return
        end
        if #gunTables == 0 then
            if typeof(getgc) ~= "function" then return end
            local okGc, allGc = pcall(getgc, true)
            if not okGc or type(allGc) ~= "table" then return end
            for _, v in ipairs(allGc) do
                pcall(function()
                    if type(v) == "table" and type(rawget(v, "WeaponType")) == "string" and type(rawget(v, "FireRate")) == "number" then
                        table.insert(gunTables, v)
                    end
                end)
            end
        end
        local want = math.clamp(Settings.FireRateVal or 700, 60, 900)
        for _, t in ipairs(gunTables) do
            pcall(function()
                if Settings.NoRecoilEnabled and t.Recoil then
                    if t.Recoil.Vertical ~= nil then t.Recoil.Vertical = 0 end
                    if t.Recoil.Horizontal ~= nil then t.Recoil.Horizontal = 0 end
                end
                if Settings.NoRecoilEnabled then
                    if t.ViewPunch ~= nil then t.ViewPunch = 0 end
                end
                if Settings.FullAuto then
                    if rawget(t, "__stockMode") == nil then rawset(t, "__stockMode", t.FireMode) end
                    t.FireMode = "Auto"
                    -- (BurstAmount left stock: zeroing it broke burst guns = no damage).*
                    if t.Automatic ~= nil then t.Automatic = true end
                end
                if Settings.NoSpread then
                    if rawget(t, "__stockSpread") == nil and type(t.Spread) == "number" then rawset(t, "__stockSpread", t.Spread) end
                    pcall(function() t.Spread = 0 end)
                elseif rawget(t, "__stockSpread") ~= nil and type(t.Spread) == "number" then
                    t.Spread = rawget(t, "__stockSpread")
                end
                if Settings.InstReload then t.ReloadAnimSpeed = 10 t.ReloadTime = 0.05 end
                if rawget(t, "__stockRate") == nil then rawset(t, "__stockRate", t.FireRate) end
                local cap = rawget(t, "__stockRate")
                if type(cap) ~= "number" then cap = 900 end
                t.FireRate = math.min(want, cap)
                local ch2 = LocalPlayer.Character
                if ch2 then
                    if Settings.NoRecoilEnabled then ch2:SetAttribute("Recoil_Control", 1) end
                end
            end)
        end
    end
