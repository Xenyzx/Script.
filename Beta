        pcall(function()
            if isfile("retro-config.json") then
                local data = game:GetService("HttpService"):JSONDecode(readfile("retro-config.json"))
                if type(data) == "table" then
                    for k, v in pairs(data) do pcall(function() if Settings[k] ~= nil then Settings[k] = v end end) end
                    if type(data.ItemCats) == "table" then for ck, cv in pairs(data.ItemCats) do if Settings.ItemCats[ck] ~= nil then Settings.ItemCats[ck] = cv end end end
                    if Settings.SpeedEnabled then pcall(function() enableSpeed(true) end) else pcall(function() enableSpeed(false) end) end
